# hst.rio: host procs taking structs, for tests/host.c, which includes the C header rio -H makes of it
Shape* :: enum
  dot, box
end
Pos* :: struct
  x, y: Int
end
Opts* :: struct
  at: Pos
  scale: Float
  kind: Shape(2)
  flip: Bool(1)
  lean: Int(-5)
  tag: Blob[6]
  name: String
  ps: [2]Pos
end
draw* :: host proc(id: Int, o?: Opts) -> Int
mark* :: host proc(p: Pos, n: Int)
fill* :: host proc(p: &Pos, by: Int)   # p's x by more, its y by twice that
count* :: host proc(n: &Int)           # n, one more
grow* :: host proc(s: &[2]Int, by: Int)  # each of s, by more: an array's place, the host's &(ii)
measure* :: host proc(n: Int, size?: &[2]Int) -> Int # n * 2, and {n, n + 1} into size, if it's given
where* :: host proc(i: Int, k?: Int) -> Pos   # {x = i, y = i * 2 + k}
find* :: host proc(i: Int) -> ?Int     # i * 3, or nil for 0 or less
paint* :: host proc(s: Shape) -> Int   # s's number, times 10
Pos.at* :: static host proc(x, y: Int) -> Pos   # {x, y}: a static host proc, the host's Pos_at
box* :: host proc(pos, size: [2]Int, c: Int) -> Int   # a point and a size go as words: the host's i i i i i
mid* :: host proc(a: [2]Float, f: Float) -> Float     # (f f f)
span* :: host proc(a, b: Int) -> [2]Int           # {a + b, a * b}: its words back, as the host's >ii
