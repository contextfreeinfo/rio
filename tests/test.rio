# rio test suite: prints "FAIL" on any failed check (ctest watches for it)

fails := 0
check :: proc(ok: Bool, what: String)
  if not ok
    log("FAIL:", what)
    fails += 1
  end
end

# ---- arithmetic & inference
a := 7
b := 3
check(a + b == 10, "add")
check(a - b * 2 == 1, "precedence")
check(a / b == 2 and a % b == 1, "div mod")
check(-a == -7 and ~0 == -1 and not false, "unary")
check((a << 2) == 28 and (-16 >> 2) == -4, "shifts")
check((a & 3) == 3 and (a | 8) == 15 and (a ^ 1) == 6, "bitops")
check(0x7fffffff + 1 == -2147483647 - 1, "wraparound")
check(0b1010 == 10 and 0B11 == 3 and 0xff == 255 and 0Xab == 171, "hex and binary")
check(1_000_000 == 1000000 and 0xFFFF_FFFF == -1 and 0b1111_0000 == 240, "digit separators")
check(-2147483648 == 0x8000_0000 and 2147483647 == 0x7FFF_FFFF, "Int range literals")
check(1_000.25 == 1000.25 and 1.000_5 == 1.0005 and 2e1_0 == 2e10, "separators in floats")
x := 1.5
y : Float = 2
check(x * y == 3.0, "float mul")
check(x + 1 == 2.5, "const coercion")
check(a.toFloat() / 2 == 3.5, "itof")
check(3.9.toInt() == 3 and (-3.9).toInt() == -3, "ftoi")
parsedIs :: proc(n: ?Int, want: Int) -> Bool
  return n is Int and n == want
end
parsedFloatIs :: proc(f: ?Float, want: Float) -> Bool
  return f is Float and f == want
end
check(parsedIs("42".toInt(), 42) and parsedIs("-17".toInt(), -17) and parsedIs("+5".toInt(), 5), "text to Int")
check(parsedIs("ff".toInt(16), 255) and parsedIs("ffffffff".toInt(16), -1) and parsedIs("Zz".toInt(36), 1295), "text to Int, bases")
check(parsedIs("-2147483648".toInt(), -2147483647 - 1) and "2147483648".toInt() is nil, "text to Int, range")
check("".toInt() is nil and "-".toInt() is nil and " 1".toInt() is nil and "1_0".toInt() is nil and "12".toInt(2) is nil, "text to Int, bad")
check("100000000".toInt(16) is nil and parsedIs("17".toInt(0), 17), "text to Int, 32 bits; base 0")
parseBase := 8
pb: Blob[..8]
check(pb.pushAll("17") and parsedIs("17".toInt(parseBase), 15) and parsedIs(pb.toInt(), 17) and parsedIs(pb[0..<1].toInt(), 1), "text to Int, at runtime")
check(parsedFloatIs("1.5".toFloat(), 1.5) and parsedFloatIs("-2e-3".toFloat(), -2e-3) and parsedFloatIs("0.1".toFloat(), 0.1), "text to Float")
check(parsedFloatIs("3.4028235e38".toFloat(), 3.4028235e38) and parsedFloatIs("7".toFloat(), 7), "text to Float, as literals")
check("1.".toFloat() is nil and ".5".toFloat() is nil and "1e".toFloat() is nil and "nan".toFloat() is nil, "text to Float, bad")
c := 10
c += 5
c -= 1
c *= 2
c /= 4
check(c == 7, "compound assign")
check(1 < 2 and 2 <= 2 and 3 > 2 and 3 >= 3 and 1 != 2, "compare")
pa := true
pb := false
px := 5
check(not px == 4 and not (px == 4), "not binds looser than ==: not x == 4 is not (x == 4)")
check((not pa and pb) == false and (pa or pb and false) == true, "or < and < not, like Python")
check(not not pa and not (pa and pb), "not stacks and takes parentheses")
check(false or true, "or")
check(not (true and false), "and")

# ---- Bool
done := false
check(not done and done == false and done != true, "bool basics")
done = 3 > 2
check(done, "bool from compare")
flags: [4]Bool
flags[2] = true
check(not flags[0] and flags[2], "bool array")
check(true.toInt() + false.toInt() == 1 and 5.toBool() and not 0.toBool(), "bool casts")
nz := 7
check(nz.toBool() and (nz > 3).toInt() == 1, "bool casts runtime")
both :: proc(a: Bool, b: Bool) -> Bool
  return a and b
end
check(both(true, nz == 7) and not both(true, false), "bool params/return")
Flag :: struct
  on: Bool
  n: Int
end
fl := Flag{on = true, n = 2}
check(fl.on, "bool field")

# ---- constants
N :: 16
HALF :: N / 2
PI :: 3.14159
GREETING :: "hello"
check(HALF == 8, "const fold")
check(GREETING == "hello" and GREETING.len() == 5, "string const")
# longer than the window the streamed run reads through
LONG :: "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
check(LONG.len() == 220 and LONG[219] == '9', "long string")

# ---- control flow
sum := 0
for i in 0..<10
  sum += i
end
check(sum == 45, "for range")
sum = 0
for i in 1..=10
  if i % 2 == 0
    continue
  end
  sum += i
end
check(sum == 25, "for continue")
n := 0
for n < 100
  n += 7
end
check(n == 105, "while")
n = 0
for
  n += 1
  if n == 5
    break
  end
end
check(n == 5, "loop break")
grade := 75
g := 0
if grade >= 90
  g = 1
case grade >= 70
  g = 2
else
  g = 3
end
check(g == 2, "case")

# ---- structs & contiguous arrays
Vec :: struct
  x, y: Float
end
Particle :: struct
  pos, vel: Vec
  life: Int
  tag: Blob[4]
end
parts: [100]Particle
for i in 0..<parts.len()
  parts[i].pos = Vec{x = i.toFloat(), y = 0}
  parts[i].vel = Vec{x = 1, y = 2}
  parts[i].life = i
end
step :: proc(ps: []Particle, dt: Float)
  for i in 0..<ps.len()
    ps[i].pos.x += ps[i].vel.x * dt
    ps[i].pos.y += ps[i].vel.y * dt
    ps[i].life -= 1
  end
end
step(parts, 0.5)
check(parts[10].pos.x == 10.5 and parts[10].pos.y == 1 and parts[10].life == 9, "struct array update")
step(parts[50..], 1)
check(parts[49].life == 48 and parts[50].life == 48, "subslice")
parts[3].tag[0] = 'Z'
check(parts[3].tag[0] == 90 and parts[3].tag.len() == 4, "inline blob")
v := Vec{x = 3, y = 4}
w := v
w.x = 10
check(v.x == 3 and w.x == 10, "struct copy semantics")
partial := Particle{pos = Vec{x = 1, y = 1}}
check(partial.life == 0 and partial.vel.y == 0, "partial literal zeroes")
yx := Vec{y = 5, x = 6}
check(yx.x == 6 and yx.y == 5, "named fields in any order")
mid := Particle{life = 3, pos = Vec{x = 1, y = 2},}
check(mid.vel.x == 0 and mid.vel.y == 0 and mid.life == 3 and mid.pos.y == 2, "missing middle field zeroed, trailing comma")
check(Vec{}.x == 0 and Vec{}.y == 0, "empty literal")
for k in 0..<2
  q := Particle{life = k, pos = Vec{x = 1, y = 1}}
  if k == 0
    q.vel = Vec{x = 9, y = 9}
  else
    check(q.vel.x == 0 and q.vel.y == 0 and q.life == 1, "literal zeroes stale slots")
  end
end
# ordered init is just a helper proc
vec :: proc(x: Float, y: Float) -> Vec
  return Vec{x = x, y = y}
end
check(vec(7, 8).y == 8, "helper for ordered init")

dot :: proc(a: Vec, b: Vec) -> Float
  return a.x * b.x + a.y * b.y
end
add :: proc(a: Vec, b: Vec) -> Vec
  return Vec{x = a.x + b.x, y = a.y + b.y}
end
check(dot(v, Vec{x = 1, y = 1}) == 7, "struct params")
r := add(v, add(v, v))
check(r.x == 9 and r.y == 12, "struct return nested")
check(add(v, v).y == 8, "field of call")

# ---- slices, blobs, strings
data: [8]Int
for i in 0..<8
  data[i] = i * i
end
total :: proc(s: []Int) -> Int
  t := 0
  for i in 0..<s.len()
    t += s[i]
  end
  return t
end
check(total(data) == 140, "array to slice")
check(total(data[2..<4]) == 13, "slice range")
check(total(data[..<3]) == 5 and total(data[6..]) == 85, "open slices")
mid := data[1..<7]
check(mid.len() == 6 and mid[0] == 1, "slice var")
buf: Blob[16]
for i in 0..<buf.len()
  buf[i] = 'a' + i
end
s := buf[0..<5].asString()
check(s == "abcde", "blob to string")
check(s[1] == 'b', "string index")
check(buf[255 & 3] == 'd', "blob index")
Named :: struct
  name: String
  id: Int
end
people: [3]Named
people[0] = Named{name = "ann", id = 1}
people[1].name = "bob"
check(people[1].name == "bob" and people[0].name.len() == 3, "strings in global structs")

# ---- math builtins
check(abs(-3) == 3 and abs(-2.5) == 2.5, "abs")
check(min(3, 4) == 3 and max(2.0, 5) == 5.0, "min max")
check(sqrt(16) == 4 and floor(2.7) == 2 and ceil(2.1) == 3 and round(2.5) == 3, "math")
check(abs(sin(0.0)) < 0.0001 and abs(cos(0.0) - 1) < 0.0001, "trig")
check(pow(2, 10) == 1024 and abs(atan2(1, 1) - PI / 4) < 0.001, "math2")

# ---- procs calling procs (no recursion)
sq :: proc(v: Int) -> Int
  return v * v
end
sumsq :: proc(a: Int, b: Int) -> Int
  return sq(a) + sq(b)
end
check(sumsq(3, 4) == 25 and sq(sq(2)) == 16 and sumsq(sq(1), sumsq(1, 1)) == 5, "nested calls")
counter := 0
bump :: proc()
  counter += 1
end
bump()
bump()
check(counter == 2, "globals from procs")

# ---- locals inside procs (static frames; AOT turns these into C locals)
scale2 :: proc(v: Vec, k: Float) -> Vec
  return Vec{x = v.x * k, y = v.y * k}
end
locals :: proc(n: Int) -> Int
  arr: [8]Int
  for i in 0..<arr.len()
    arr[i] = i + n
  end
  view := arr[2..<6]
  t := total(view)
  v := Vec{x = 1, y = 2}
  w := scale2(v, 3)
  big: [32]Vec
  big[31] = w
  q := big[31]
  b: Blob[8]
  b[7] = 9
  j := 0
  for j < 3
    j += 1
  end
  part := Particle{pos = v, vel = w, life = 5}
  part.tag[1] = 4
  return t + (q.x + q.y).toInt() + b[7] + j + part.life + part.tag[1]
end
check(locals(10) == 54 + 9 + 9 + 3 + 5 + 4, "proc locals")
check(locals(0) == 14 + 30, "proc locals again")
nanv := sqrt(-1.0)
check(not (nanv < 1) and not (nanv >= 1) and nanv != nanv, "nan compares")
lt := 0
if nanv < 1
  lt = 1
end
check(lt == 0, "nan branch")

# ---- builders ([..N]T storage) and builder views ([..]T)
Enemy :: struct
  x, hp: Int
end
enemies: [..4]Enemy
check(enemies.len() == 0 and enemies.cap() == 4, "empty builder")
spawnE :: proc(out: [..]Enemy, x: Int) -> Bool
  return out.push(Enemy{x = x, hp = 3})
end
for i in 0..<6
  spawnE(enemies, i * 10)
end
check(enemies.len() == 4 and enemies[3].x == 30, "push through a view; full builder drops")
check(not enemies.push(Enemy{x = 99}), "push when full is false")
enemies[1].hp -= 1
enemies.swapRemove(0)
check(enemies.len() == 3 and enemies[0].x == 30 and enemies[1].hp == 2, "swapRemove")
enemies.remove(0)
check(enemies.len() == 2 and enemies[0].x == 10 and enemies[1].x == 20, "remove keeps order")
last := enemies.pop()
check(last.x == 20 and enemies.len() == 1, "pop")
live := enemies[]
check(live.len() == 1 and live[0].x == 10, "builder [] is a slice of live elements")
enemies.clear()
check(enemies.len() == 0, "clear")
nums: [..8]Int
for i in 0..<5
  nums.push(i * i)
end
check(nums[4] == 16 and total(nums[]) == 30 and total(nums[1..<3]) == 5, "Int builder and sub-slices")
title: Blob[..32]
label :: proc(b: Blob[..], score: Int) -> Bool
  b.clear()
  return b.print("score: ", score, " ", 1.5, " ", true) and b.push('!')
end
check(label(title, 42) and title[].asString() == "score: 42 1.5 true!", "print appends text; push adds one byte")
tiny: Blob[..6]
check(tiny.pushAll("abc") and not tiny.print("de", 12345) and tiny.len() == 3, "print is all or nothing")
check(tiny.print(12) and tiny.push(65) and tiny[].asString() == "abc12A" and not tiny.push(66), "push on a Blob builder is a byte")
check(tiny.print(), "print with nothing to add")

# printing any value: structs, arrays, slices, builders and unions, by their types' descriptors
PrDir :: enum
  north, east
end
PrPoint :: struct
  x, y: Int
end
PrBox :: struct
  w, h: Float
end
PrShape :: union
  nil
  PrPoint, PrBox
end
PrThing :: struct
  name: String
  at: PrPoint
  dir: PrDir
  tags: [3]Int
  ok: Bool
  label: Blob[2]
end
prOut: Blob[..400]
prSays :: proc(want: String) -> Bool
  got := prOut[].asString() == want
  prOut.clear()
  return got
end
prP := PrPoint{x = 1, y = -2}
check(prOut.print(prP) and prSays("PrPoint{x = 1, y = -2}"), "print a struct")
prXs := [4]Int{1, 2, 3, 4}
check(prOut.print(prXs, " ", prXs[1..<3]) and prSays("[1, 2, 3, 4] [2, 3]"), "print an array and a slice")
prS: PrShape
check(prOut.print(prS) and prSays("nil"), "print a union holding nil")
prS = PrBox{w = 2.5, h = 3}
check(prOut.print(prS) and prSays("PrBox{w = 2.5, h = 3.0}"), "print a union by what it holds")
prT := PrThing{name = "say \"hi\"\n", at = prP, dir = PrDir.east, tags = {7, 8, 9}, ok = true}
prT.label[0] = 65
check(prOut.print(prT) and prSays("PrThing{name = \"say \\\"hi\\\"\\n\", at = PrPoint{x = 1, y = -2}, dir = east, tags = [7, 8, 9], ok = true, label = \"A\\0\"}"),
      "print a struct of structs, enums, arrays and text (quoted inside a value)")
prNs: [..8]Int
check(prNs.push(10) and prNs.push(20) and prOut.print(prNs, " ", prNs[]) and prSays("[10, 20] [10, 20]"), "print a builder, and its view")
prBig: [50]Int
check(prOut.print(prBig) and prOut.len() == 150, "print writes all of a long array (no cut, unlike log)")
prOut.clear()
prTiny: Blob[..12]
check(not prTiny.print("ab", prP) and prTiny.len() == 0, "print of a value that doesn't fit: none of it")
prWs := [2]String{"one", "two"}
check(prOut.print(prWs) and prSays("[\"one\", \"two\"]"), "strings inside an array are quoted")

# format: its settings first, for all the values after them
check(prOut.format({width = 5}, 42, " ", -7) and prSays("   42    -7"), "format: width pads numbers, not text")
check(prOut.format({width = -5, textWidth = -6}, 42, "ab", true) and prSays("42   ab    true  "), "format: negative widths align left; textWidth pads text and Bools")
check(prOut.format({digits = 3}, 7, " ", -7, " ", 1234) and prSays("007 -007 1234"), "format: digits pads with zeros")
check(prOut.format({base = 16}, 255, " ", -1) and prSays("ff ffffffff"), "format: base 16, of the bits")
check(prOut.format({base = 2, digits = 8}, 5) and prSays("00000101"), "format: base 2, with digits")
check(prOut.format({places = 2}, 3.14159, " ", -0.5, " ", 2.0) and prSays("3.14 -0.50 2.00"), "format: places")
check(prOut.format({places = 1, digits = 2, width = 6}, 1.25) and prSays("  01.3"), "format: places, digits and width together")
check(prOut.format({digits = 3}, 1.5) and prSays("001.5"), "format: digits without places")
check(prOut.format({textWidth = 6}, PrDir.east) and prSays("  east"), "format: an enum's name is text")
check(prOut.format({digits = 2}, prP, " ", prXs[0..<2]) and prSays("PrPoint{x = 01, y = -02} [01, 02]"), "format: inside structs and slices too")
fmtHex := Format{width = 4, digits = 4, base = 16}
check(prOut.format(fmtHex, 48879, 10) and prSays("beef000a"), "format: settings in a variable")
check(prOut.format(fmtHex, fmtHex) and prSays("Format{width = 0004, digits = 0004, places = 0000, base = 0010, textWidth = 0000}"),
      "format: a Format after the first is a value")
check(prOut.print(fmtHex) and prSays("Format{width = 4, digits = 4, places = 0, base = 16, textWidth = 0}"), "print a Format")
check(not prTiny.format({width = 20}, 1) and prTiny.len() == 0, "format is all or nothing")
fmtWide := 3
check(prOut.format({width = fmtWide + 1}, 9) and prSays("   9"), "format: settings computed at runtime")
more: [..8]Int
check(more.pushAll(nums) and not more.pushAll(nums) and more.len() == 5 and more[4] == 16, "pushAll is all or nothing")
check(more.pushAll(nums[3..]) and more.len() == 7 and more[6] == 16, "pushAll from a slice")
localBuilder :: proc() -> Int
  xs: [..3]Int
  xs.push(5)
  xs.push(6)
  v := xs
  v.push(7)
  return xs.len() * 100 + xs[2] + v.cap()
end
check(localBuilder() == 310 and localBuilder() == 310, "local builder resets per call; := makes a view")
Inv :: struct
  items: [..3]Int
  gold: Int
end
bags: [2]Inv
bags[1].items.push(9)
check(bags[1].items.len() == 1 and bags[1].items[0] == 9 and bags[0].items.len() == 0, "builder inside a struct inside an array")

# ---- methods: Type.name :: proc, with an implicit self
Ship :: struct
  x, vx: Float
  hp: Int
end
Ship.move :: proc(dt: Float)
  self.x += self.vx * dt
end
Ship.hurt :: proc(n: Int) -> Bool
  self.hp -= n
  return self.hp <= 0
end
Ship.reset :: proc()
  self = Ship{hp = 3}
end
Ship.pos :: proc() -> Float
  return self.x
end
Ship.step :: proc(dt: Float)
  self.move(dt)
end
fleet: [3]Ship
for i in 0..<3
  fleet[i] = Ship{x = i.toFloat(), vx = 2, hp = 2}
end
fleet[1].step(0.5)
check(fleet[1].x == 2 and fleet[0].x == 0, "a method updates its receiver in place")
check(not fleet[2].hurt(1) and fleet[2].hurt(1) and fleet[2].hp == 0, "method results and receiver updates")
solo := Ship{x = 5, vx = 1, hp = 1}
solo.reset()
check(solo.hp == 3 and solo.x == 0, "assigning self replaces the receiver")
twin := solo
twin.vx = 1
twin.move(10)
check(solo.x == 0 and twin.x == 10, "methods act on the variable they're called on")
check(Ship{x = 7}.pos() == 7, "method on a temporary")
moveAll :: proc(ships: []Ship, dt: Float)
  for i in 0..<ships.len()
    ships[i].move(dt)
  end
end
moveAll(fleet[..<2], 1)
check(fleet[0].x == 2 and fleet[1].x == 4 and fleet[2].x == 2, "methods through a slice")
Int.double :: proc() -> Int
  return self * 2
end
Int.bump :: proc()
  self += 1
end
k := 21
k.bump()
check(k.double() == 42 and k == 21 and (k + 1).double() == 44, "Int methods get a copy of self")
String.first :: proc() -> Int
  return self[0]
end
check("hey".first() == 'h', "String methods")
update :: proc() -> Int
  return 7
end
Ship.update :: proc() -> Int
  return self.hp
end
Bullet :: struct
  hp: Int
end
Bullet.update :: proc() -> Int
  return self.hp + 100
end
b1 := Bullet{hp = 1}
check(update() == 7 and solo.update() == 3 and b1.update() == 101, "procs and each type's methods have separate names")

# ---- struct literals typed by where they're going: {field = ...}
tv: Vec = {x = 1, y = 2}
check(tv.x == 1 and tv.y == 2, "typed by a declaration")
tv = {y = 9}
check(tv.x == 0 and tv.y == 9, "typed by an assignment")
check(dot({x = 1, y = 1}, {x = 2, y = 3}) == 5, "typed by parameters")
mk :: proc(x: Float) -> Vec
  return {x = x, y = -x}
end
check(mk(2).y == -2, "typed by a return type")
pp := Particle{pos = {x = 3, y = 4}, life = 1}
check(pp.pos.y == 4 and pp.life == 1, "typed by a field")
pp.vel = {x = 5}
check(pp.vel.x == 5, "typed by a field assignment")
shipq: [..2]Ship
check(shipq.push({hp = 5}) and shipq[0].hp == 5, "typed by push")
fleet[0] = {x = 9, hp = 4}
check(fleet[0].x == 9 and fleet[0].vx == 0, "typed by an element assignment")
Ship.aim :: proc(v: Vec) -> Float
  return v.x + v.y + self.x
end
check(fleet[0].aim({x = 1, y = 2}) == 12, "typed by a method parameter")

# ---- field punning: {x} means {x = x}; {a.b.x} means {x = a.b.x}
pv: Vec = {x, y}
check(pv.x == 1.5 and pv.y == 2, "punning globals")
mkv :: proc(x: Float, y: Float) -> Vec
  return {x, y}
end
check(mkv(3, 4).x == 3 and mkv(3, 4).y == 4, "punning parameters")
src := Particle{pos = {x = 1, y = 2}, vel = {x = 3, y = 4}, life = 7}
cp := Particle{src.pos, src.life, vel = {y = src.vel.y}}
check(cp.pos.y == 2 and cp.life == 7 and cp.vel.x == 0 and cp.vel.y == 4, "deep punning uses the last name")
Ship.at :: proc() -> Vec
  return {self.x, y = self.hp.toFloat()}
end
check(fleet[0].at().x == 9 and fleet[0].at().y == 4, "punning self fields")
check(Vec{src.pos.y, x = 0}.y == 2, "deep path, mixed with named fields")
pv2 := Vec{
  x,  # a comment between items
  y   # and before the brace
}
check(pv2.x == 1.5 and pv2.y == 2, "punning across lines, with comments")

# ---- destructuring: {a, b as c} := struct
QR :: struct
  q, r: Int
end
divmod :: proc(a: Int, b: Int) -> QR
  return {q = a / b, r = a % b}
end
{q, r} := divmod(17, 5)
check(q == 3 and r == 2, "destructure a call result")
{r as rem, q as quo,} := divmod(9, 4)
check(rem == 1 and quo == 2, "rename with as, any order, trailing comma")
{pos, life} := src
check(pos.y == 2 and life == 7, "struct and Int fields")
{x as fx} := fleet[1]
check(fx == fleet[1].x, "partial, from an array element")
mover :: proc() -> Float
  {x as sx, vx} := fleet[1]
  sx += vx
  return sx - fleet[1].x
end
check(mover() == fleet[1].vx, "the names are copies; works in procs")
{tag} := parts[3]
check(tag[0] == 90 and tag.len() == 4, "an inline Blob field becomes a view")
nested :: proc(ps: []Particle, i: Int) -> Float
  {pos as p, vel} := ps[i]
  {x, y as py} := p
  return x + py + vel.y
end
check(nested(parts, 10) == 10.5 + 1 + 2, "through a slice, then shallow again")
as := 5
check(as == 5, "as is still an ordinary name elsewhere")

# ---- for x in xs: x is the element itself (no copy, no bounds checks), with an optional index
squad: [4]Ship
for s, i in squad
  s = {x = i.toFloat(), vx = 1, hp = i}
end
for s in squad
  s.move(2)
  s.hp += 10
end
check(squad[3].x == 5 and squad[0].hp == 10 and squad[3].hp == 13, "elements are written in place")
seen := 0
for s, i in squad[1..<3]
  seen += s.hp * 10 + i
end
check(seen == 110 + 120 + 1, "a slice, with its own index")
hits: [..8]Int
hits.push(4)
hits.push(5)
hsum := 0
for h in hits
  hsum += h
  h = 1
  if hsum > 0
    hits.push(9)
  end
end
check(hsum == 9 and hits[0] == 1 and hits[1] == 1 and hits.len() == 4, "a builder: the elements there when the loop starts")
empty: [..2]Int
ran := false
for x in empty
  ran = true
end
check(not ran, "an empty builder runs no iterations")
word := 0
for c, i in "rio"
  word = word * 256 + c
  check(i < 3, "string index")
end
check(word == 0x72696f, "string bytes")
raw: Blob[3]
for b, i in raw
  b = i + 250
end
check(raw[2] == 252, "writing blob bytes")
grid: [2][3]Int
for row, r in grid
  for v, c in row
    v = r * 10 + c
  end
end
check(grid[1][2] == 12 and grid[0][1] == 1, "nested arrays")
firsthurt := -1
for s, i in squad
  if s.hp < 12
    continue
  end
  firsthurt = i
  break
end
check(firsthurt == 2, "continue and break")
sumhp :: proc(ss: []Ship) -> Int
  n := 0
  for s in ss
    n += s.hp
  end
  return n
end
check(sumhp(squad[]) == 10 + 11 + 12 + 13, "inside a proc, over a slice parameter")

# ---- for x in it: a struct with next() -> ?T, until nil; a variable is stepped in place
Upto :: struct
  at: Int
  last: Int
end
Upto.next :: proc() -> ?Int
  if self.at > self.last do return nil
  self.at += 1
  return self.at - 1
end
itSum := 0
for n in Upto{at = 1, last = 4}
  itSum += n
end
check(itSum == 10, "for over a struct's next, a literal")
upto := Upto{at = 1, last = 9}
itSum = 0
for n, i in upto
  check(i == n - 1, "for over next: the index counts from 0")
  if n == 3 do break
end
check(upto.at == 4, "for over next: a variable stepped in place, so a break leaves it where it stopped")
for n in upto
  if n % 2 == 0 do continue
  itSum += n
end
check(itSum == 5 + 7 + 9 and upto.at == 10, "for over next: carrying on, with continue")
for n in Upto{at = 3, last = 1}
  check(false, "for over next: nothing, when the first is nil")
end
Cell :: struct
  x: Int
  y: Int
end
Cells :: struct
  i: Int
end
Cells.next :: proc() -> ?Cell
  if self.i >= 4 do return nil
  self.i += 1
  return Cell{x = (self.i - 1) % 2, y = (self.i - 1) / 2}
end
itSum = 0
for cell in Cells{}
  itSum += cell.x + 10 * cell.y
end
check(itSum == 22, "for over next: a struct each time")
stepAll :: proc(u: &Upto) -> Int
  t := 0
  for n in u
    t += n
  end
  return t
end
upto = Upto{at = 1, last = 3}
check(stepAll(&upto) == 6 and upto.at == 4, "for over next: through a &T, inside a proc")

# ---- references: &T parameters and name := &place (never stored, returned or re-pointed)
swapvx :: proc(a: &Ship, b: &Ship)
  t := a.vx
  a.vx = b.vx
  b.vx = t
  a.hurt(1)                       # methods and fields work through a reference
end
addto :: proc(n: &Int, by: Int)
  n += by
end
mixref :: proc(a: &Ship, k: Int, b: &Ship) -> Int
  a.hp += k
  b.hp -= k
  return a.hp * 100 + b.hp
end
fill3 :: proc(g: &[3]Int, v: Int)
  for x in g
    x = v
  end
end
rename :: proc(s: &String)
  s = "renamed"
end
passon :: proc(s: &Ship)
  addto(&s.hp, 100)               # a reference passes on as &, or to a field
  swapvx(&s, &s)                  # the same place twice is allowed
end
crew: [4]Ship
for s, i in crew
  s = {vx = i.toFloat(), hp = 10}
end
swapvx(&crew[1], &crew[2])
check(crew[1].vx == 2 and crew[2].vx == 1 and crew[1].hp == 9, "& parameters change the caller's structs")
ci := 1
cj := 2
check(mixref(&crew[ci + 1], ci * 3, &crew[cj + 1]) == 1307 and crew[3].hp == 7, "& and value arguments mixed")
cnt := 1
addto(&cnt, 2)
check(cnt == 3, "& to an Int")
trio: [3]Int
fill3(&trio, 7)
check(trio[0] == 7 and trio[2] == 7, "& to an array")
label := "old"
rename(&label)
check(label == "renamed", "& to a String variable")
passon(&crew[0])
check(crew[0].hp == 109, "passing a reference on")
cr := &crew[3]
cr.hp -= 2
cr.x += 1
check(crew[3].hp == 5 and crew[3].x == 1, "a local reference is the element itself")
cr = {hp = 42}
check(crew[3].hp == 42 and crew[3].x == 0, "assigning through it writes the element")
cc := cr
cc.hp = 0
check(crew[3].hp == 42, "a plain := copies")
fhp := &crew[3].hp
fhp += 1
check(crew[3].hp == 43, "a reference to a field")
reflocal :: proc() -> Int
  sh: Ship = {hp = 1}
  r := &sh
  r.hp += 1
  addto(&r.hp, 10)
  addto(&sh.hp, 100)
  return sh.hp
end
check(reflocal() == 112, "references to locals inside a proc")

# ---- arithmetic on arrays of numbers: element by element, scalars spread (structs don't: tests/errors.c)
V2 :: [2]Float
Mover :: struct
  pos, vel: V2
end
va: [3]Float
vb: [3]Float
for v, i in va
  v = i.toFloat()
  vb[i] = 10
end
vc := va + vb
check(vc[0] == 10 and vc[2] == 12, "array + array")
vd := (va + vb) * 2.0 - va / 2
check(vd[0] == 20 and vd[1] == 21.5 and vd[2] == 23, "nested temporaries")
ve := 1.0 - va
check(ve[0] == 1 and ve[2] == -1, "scalar on the left")
vf := -va
check(vf[1] == -1 and vf[0] == 0, "unary minus")
check((va + vb)[1] == 11, "indexing a computed array")
u2 := V2{1, 2}
w2 := V2{3, 4}
s2 := u2 + w2 * 2
check(s2.x == 7 and s2.y == 10, "small arrays, Int literal spread as Float")
s2 -= u2
s2 *= 0.5
check(s2.x == 3 and s2.y == 4, "small arrays in place")
mv: Mover = {pos = {1, 1}, vel = {2, 3}}
mv.pos += mv.vel * 0.5
check(mv.pos.x == 2 and mv.pos.y == 2.5, "an array inside a struct")
ia: [4]Int
for v, i in ia
  v = i * 3 - 4
end
iq := ia / 2
ir := ia % 3
check(iq[0] == -2 and iq[3] == 2 and ir[0] == -1 and ir[3] == 2, "Int / and %")
ia *= -1
check(ia[0] == 4 and ia[3] == -5, "Int in place")
bigf: [100]Float
bigf += 2.0
bigf *= bigf
check(bigf[0] == 4 and bigf[99] == 4, "big arrays in place")
gr: [2][2]Int
gr += 5
check(gr[1][1] == 5 and gr[0][0] == 5, "nested arrays")
movers: [3]Mover
for m in movers
  m.vel = {1, 1}
  m.pos += m.vel * 3
end
check(movers[2].pos.y == 3, "through a for-each element")
vstep :: proc(v: V2, k: Float) -> V2
  t := v * k + v
  return -t
end
vo := vstep(u2, 2)
check(vo.x == -3 and vo.y == -6, "inside a proc, and returned")
vr := &mv.vel
vr *= 2.0
check(mv.vel.x == 4, "through a reference")
mp: [2]Float = {3.5, -2.5}
mq := abs(mp) + floor(mp) + round(mp)
check(mq.x == 3.5 + 3 + 4 and mq.y == 2.5 - 3 - 3, "math builtins on arrays")
mq = max(0.0, min(mp, 3.0))
check(mq.x == 3 and mq.y == 0, "min and max on arrays, a number spread")
mq = max([2]Float{1, 1}, mp)
check(mq.x == 3.5 and mq.y == 1 and pow(mp, 2.0).y == 6.25, "two arrays, and two-argument math")
mi := mp.toInt()
check(mi.x == 3 and mi.y == -2 and mi.toFloat().x == 3 and abs(mi).y == 2 and min(mi, 0).x == 0, "toInt and toFloat on arrays")
mg: [2][2]Float
mg[1] = {-1.5, 2.5}
check(abs(mg)[1][0] == 1.5 and mg.toInt()[1][1] == 2, "nested arrays")
mp = mp + {1, 1}
mp *= {2, 0}
mp -= {1, 0} * 2.0
check(mp.x == 7 and mp.y == 0, "an untyped array literal takes its partner's type")
mpts: [..4][2]Float
mpok := mpts.push({10, 20})
mpok = mpts.push({-5, 7})
for pt in mpts
  pt = max([2]Float{0, 0}, min(pt, 8.0))
end
check(mpts[0].y == 8 and mpts[1].x == 0 and mpts[1].y == 7, "clamped through a loop's element")
clo := 2
chi := 5
check(clamp(9, clo, chi) == 5 and clamp(-1, clo, chi) == 2 and clamp(3, clo, chi) == 3 and clamp(1.5, 0, 1) == 1, "clamp")
check(clamp(4, clo + chi, 6) == 7, "clamp: lo when lo > hi, a computed lo kept")
mq = clamp([2]Float{-3, 9}, 0, [2]Float{4, 5})
check(mq.x == 0 and mq.y == 5 and clamp([3]Int{-1, 3, 8}, 0, 5)[2] == 5, "clamp on arrays")

# ---- swizzles: .x .y .z .w / .r .g .b .a on arrays of 1-4 numbers or Bools
sv: [3]Float
sv.x = 1
sv.y = 2
sv.z = 3
check(sv.x == 1 and sv.z == 3 and sv[2] == 3, "one letter is the element")
sw := sv.zyx
check(sw.x == 3 and sw.z == 1, "several letters build a new array")
sc := sv.xx + sv.yz * 2.0
check(sc.x == 5 and sc.y == 7, "swizzles in arithmetic")
rgba: [4]Int
rgba.r = 255
rgba.a = 9
rgba.g += 7
sq := rgba.bgra
check(rgba.g == 7 and sq.r == 0 and sq.a == 9, "rgba")
Spr :: struct
  pos: [2]Float
end
sprs: [3]Spr
for p, i in sprs
  p.pos.y = i.toFloat()
  p.pos += p.pos.yx
end
check(sprs[2].pos.x == 2 and sprs[2].pos.y == 2, "a swizzle of the target, in place")
sz := &sv.z
sz = 10
check(sv.z == 10, "a reference to a swizzled element")
sflags: [2]Bool
sflags.y = true
check(sflags.yx.x, "Bools")
swl :: proc() -> Float
  a: [2]Float
  a.x = 3
  b := a.yxxy
  return b.z + b.w
end
check(swl() == 3, "inside a proc")

# ---- small arrays are values: x := a copies, and up to 16 words they pass and return by value
flipx :: proc(v: [2]Float) -> [2]Float
  v.x = -v.x                      # the parameter is a copy
  return v.yx
end
fa: [2]Float
fa.x = 1
fa.y = 2
fb := fa
fb.x = 9
check(fa.x == 1 and fb.x == 9, "x := array copies")
fr := flipx(fa)
check(fr.x == 2 and fr.y == -1 and fa.x == 1, "arrays pass and return by value")
fgrid: [3][2]Float
fgrid[1] = fa
frow := fgrid[1]
frow.y = 7
check(fgrid[1].y == 2 and frow.y == 7, "copying one row")
fview: []Float = fa
fview[0] = 5
check(fa.x == 5, "x: []T = array is a view")
fbig: [100]Int
fbig[3] = 4
fcopy: [100]Int = fbig
fcopy[3] = 1
fbv := fbig[]
fbv[3] = 6
check(fbig[3] == 6 and fcopy[3] == 1, "a big array: copy with a written type, view with [:]")
bump4 :: proc(m: [4][4]Float) -> [4][4]Float
  m[0][0] += 1
  return m
end
fm: [4][4]Float
fm2 := bump4(fm)
check(fm[0][0] == 0 and fm2[0][0] == 1, "16 words is still small")

# ---- builder views over any array or slice: name: [..]T = memory, starting empty
bbuf: [8]Int
bb: [..]Int = bbuf
bb.push(3)
bb.push(4)
check(bb.len() == 2 and bb.cap() == 8 and bbuf[1] == 4 and bb[1] == 4, "pushes land in the array")
bfill :: proc(out: [..]Int, n: Int)
  for i in 0..<n
    out.push(i * 10)
  end
end
bfill(bb, 3)
check(bb.len() == 5 and bb[4] == 20, "passed to a proc, the length is shared")
bpart: [..]Int = bbuf[5..<8]
bpart.push(7)
check(bbuf[5] == 7 and bpart.len() == 1 and bpart.cap() == 3 and bb.len() == 5, "over part of an array")
bsum := 0
for x in bb
  bsum += x
end
check(bsum == 37, "for-each over a builder view")
check(bb.pop() == 20 and bb.len() == 4, "pop")
bb.swapRemove(0)
check(bb[0] == 10 and bb.len() == 3, "swapRemove")
bc := bb
bc.push(99)
check(bb.len() == 4, "copies share the length")
bscr: Blob[16]
btxt: Blob[..] = bscr[4..<12]
btxt.print("hi ", 42)
check(btxt[].asString() == "hi 42" and bscr[4] == 'h', "a byte builder view over part of a Blob")
blocal :: proc() -> Int
  loc: [4]Float
  lb: [..]Float = loc
  lb.push(1.5)
  lb.push(2.5)
  xs: [..3]Int
  xs.push(1)
  v: [..]Int = xs
  v.push(2)
  return lb.len() * 10 + xs.len()
end
check(blocal() == 22, "builder views over locals and builders inside a proc")

# ---- procs that never run at the same time share frame memory; a caller's locals survive its calls
shA :: proc(x: Int) -> Int
  t := x * 3
  return t + 1
end
shB :: proc(x: Int) -> Int            # never runs alongside shA: may use the same memory
  u := x + 100
  w := u * 2
  return w - u
end
shC :: proc(x: Int) -> Int
  a := shA(x)
  b := shB(x)                         # a lives in shC's own frame, above both
  c := shA(b)
  return a * 1000000 + b * 1000 + c
end
check(shC(2) == 7 * 1000000 + 102 * 1000 + 307, "shared frames keep each caller's locals")
shV :: proc(v: [2]Float) -> [2]Float
  t := v * 2.0
  return t.yx
end
shW :: proc() -> Float
  p: [2]Float
  p.x = 1
  p.y = 2
  q := shV(p)
  r := shV(q)
  return p.x + q.x * 10 + r.x * 100
end
check(shW() == 1 + 40 + 400, "array values through shared frames")

# ---- comments start with #; inside strings and char literals it's just a character
hstr := "a # b"
check(hstr.len() == 5 and hstr[2] == '#' and '#' == 35, "# in a string or char literal") # a comment here too

# ---- enums: their own type, stored as an Int; .value where the type is known
Dir :: enum
  north, east, south, west
end
Tile :: enum
  nil
  wall
  water
end
turn :: proc(d: Dir) -> Dir
  return Dir.fromInt((d.toInt() + 1) % 4)
end
ed: Dir
check(ed == .north and ed == Dir.north, "the first value is the zero")
ed = .south
check(ed.toInt() == 2 and turn(ed) == .west and turn(turn(ed)) == .north, "toInt and fromInt")
et: Tile
check(et == nil and Tile.water.toInt() == 2 and Tile.has(2) and not Tile.has(3) and not Tile.has(-1) and Tile.has(0), "nil first, and values 0 to n - 1")
enumSeen := 0
for tile, at in Tile
  enumSeen = enumSeen * 10 + tile.toInt() + at
end
check(enumSeen == 24, "for over an enum, with an index")
EMob :: struct
  facing: Dir
  hp: Int
end
emob := EMob{facing = .west, hp = 3}
check(emob.facing == .west, "a target-typed value in a struct literal")
eds: [4]Dir
for x, i in eds
  x = Dir.fromInt(i)
end
check(eds[3] == .west and eds[0] != .east, "an array of enums")
enames: Blob[..64]
for d, i in Dir                         # an enum's values, in the order listed
  enames.print(d, i, " ")
end
check(enames[].asString() == "north0 east1 south2 west3 ", "for d in Dir, and print prints names")
ecounts: [Dir]Int                       # one element per value, indexed by the enum
ecounts[.east] = 3
ecounts[Dir.west] += 2
ed = .east
ecounts[ed] += 1
check(ecounts[.east] == 4 and ecounts[.west] == 2 and ecounts[.north] == 0 and ecounts.len() == 4, "an enum-indexed array")
ewhich := 0
for c, dd in ecounts                    # the index is the enum
  if dd == .west
    ewhich = c
  end
end
check(ewhich == 2, "for over an enum-indexed array")
check(ecounts[Dir.fromInt(Dir.east.toInt())] == 4, "d.toInt() is d's element")
epart := ecounts[.east..<.west]           # bounds are values; like any slice, the end isn't included
check(epart.len() == 2 and epart[0] == 4 and ecounts[.south..].len() == 2 and ecounts[..<.east].len() == 1, "slicing with enum values")

# ---- switch: case values (several per case), else, and every enum value covered
compass :: proc(d: Dir) -> Int
  switch d
  case .north
    return 1
  case .east, .west
    return 2
  case .south
    return 3
  end
  return 0
end
check(compass(.north) == 1 and compass(.west) == 2 and compass(.south) == 3, "switch on an enum")
bucket :: proc(n: Int) -> Int
  r := 0
  switch n % 5
  case 0
    r = 10
  case 1, 2
    t := n * 2
    r = t
  else
    r = -1
  end
  return r
end
check(bucket(5) == 10 and bucket(6) == 12 and bucket(7) == 14 and bucket(8) == -1, "switch on an Int with else")
sseen := 0
for i in 0..<4
  switch i
  case 1
    continue                          # break and continue are for loops
  end
  sseen += i
end
check(sseen == 0 + 2 + 3, "continue from inside a switch")
switch sq := Dir.fromInt(2)
case .south
  check(sq == .south, "switch name := value")
else
  check(false, "switch name := value")
end

# ---- unions: a named list of types; is tests, and inside a case or an if the variable is that type
Circle :: struct
  r: Float
end
Box :: struct
  w, h: Float
end
Shape :: union
  nil
  Circle, Box
end
uarea :: proc(s: Shape) -> Float
  switch s
  case Circle
    return 3.0 * s.r * s.r
  case Box
    return s.w * s.h
  case nil
    return -1
  end
  return 0
end
ua: Shape
check(ua is nil and uarea(ua) == -1, "nil first is the zero")
ua = Circle{r = 2}
check(ua is Circle and not (ua is Box) and uarea(ua) == 12, "a value of one of its types")
ub: Shape = Box{w = 3, h = 4}
ubw := 0.0
if ub is Box
  ubw = ub.w                          # narrowed by the if
end
check(ubw == 3 and uarea(ub) == 12, "narrowed in an if")
if ub is Box
  ub = Circle{r = ub.w}               # the new value is read while ub is still the Box
end
check(ub is Circle and uarea(ub) == 27, "replacing a narrowed union from its own value")
uhit := true
uboth := 0.0
if uhit and ua is Circle and ub is Circle
  uboth = ua.r + ub.r                 # every x is T joined by && narrows
end
check(uboth == 5, "narrowed by && parts of a condition")
check(ua is Circle and ua.r == 2 and ub is Circle and ua.r + ub.r == 5, "narrowed on the right of and")
check(ua is Circle and ua is Circle and not (ua is Box), "is on a narrowed name: known while compiling")
umaybe: ?Int
check(not (umaybe is Int and umaybe > 0), "and skips its right side when its left is false")
umaybe = 3
uright := 0
if umaybe is Int and umaybe > 2 do uright = umaybe
check(uright == 3, "narrowed on the right of and, then in the if")
ucase := 0.0
if ua is Box
  ucase = ua.w
case ua is Circle
  ucase = ua.r                        # a case's condition narrows inside it too
end
check(ucase == 2, "narrowed in a case")
ushapes: [3]Shape
ushapes[1] = Circle{r = 1}
ushapes[2] = Box{w = 1, h = 2}
utotal := 0.0
for s in ushapes
  utotal += uarea(s)
end
check(utotal == -1 + 3 + 2, "an array of unions")
UIdle :: struct
  t: Int
end
UWalk :: struct
  speed: Float
end
Pose :: union
  UIdle, UWalk
end
pose: Pose
ulog := 0
for i in 0..<3
  switch pose
  case UIdle
    if pose.t == 0
      pose = UWalk{speed = 1.5}       # replaces the union: pose is the union again from here
      check(pose is UWalk, "assigning inside a case")
      ulog += 1
    end
  case UWalk
    ulog += 10
    pose = UIdle{t = 9}
  end
end
check(ulog == 11 and pose is UIdle, "a state machine")
Num :: union
  Int, Float
end
unum: Num = 3
check(unum is Int, "a union of Int and Float")
unum = 2.5
uf := 0.0
switch unum
case Int
  uf = unum.toFloat()
case Float
  uf = unum
end
check(uf == 2.5, "narrowed to Float")

# ---- a switch on conditions: the first true case runs, as in an if
swc := 0
swx := 7
switch
case swx > 10
  swc = 1
case swx > 5
  swc = 2
else
  swc = 3
end
check(swc == 2, "switch on conditions")
switch
case swx < 0
  swc = 9
end
check(swc == 2, "switch on conditions, none true")
sign :: proc(n: Int) -> Int
  if n > 0
    return 1
  case n < 0
    return -1
  else
    return 0
  end
end
check(sign(5) + sign(-5) + sign(0) == 0, "every case returns")

# ---- if and switch as values: right after :=, = or return, each branch's last line its value
VSize :: enum
  small, big, huge
end
vk := VSize.big
vsz := switch vk
case .small
  1
case .big
  vt := 10
  vt * 2
case .huge
  100
end
check(vsz == 20, "switch as a value, over an enum, every value covered")
vn := 7
vlabel := if vn < 5
  "low"
case vn < 10
  "mid"
else
  "high"
end
check(vlabel == "mid", "if as a value, with case")
vsz = switch vn
case 1, 2 do 0
else
  vn * 3
end
check(vsz == 21, "assigned, a one-line case among them")
vpt: [2]Float = if vn > 3
  {1, 2}
else
  {3, 4}
end
check(vpt.y == 2, "a literal taking the variable's type")
VPair :: struct
  a: Int
  b: String
end
vpair: VPair = switch vn
case 7
  {a = 5, b = "five"}
else
  {}
end
check(vpair.a == 5 and vpair.b == "five", "a struct literal")
vsign :: proc(x: Int) -> Int
  return if x > 0
    1
  case x < 0
    -1
  else
    0
  end
end
check(vsign(5) == 1 and vsign(-5) == -1 and vsign(0) == 0, "returned")
vword :: proc(x: Int) -> String
  w := if x > 0
    "pos"
  case x < 0
    return "neg, early"
  else
    "zero"
  end
  return w
end
check(vword(1) == "pos" and vword(-1) == "neg, early" and vword(0) == "zero", "a branch that returns has no value")
vnest := if vn > 0
  vy := switch vn
  case 7 do 70
  else
    0
  end
  vy + 1
else
  0
end
check(vnest == 71, "nested")
VU :: union
  Int, String
end
vu: VU = if vn > 1
  5
else
  "s"
end
check(vu is Int and vu == 5, "into a union")
vtotal := 0
for vi in 0..<4
  vstep := switch vi
  case 0 do 5
  else
    vi
  end
  vtotal += vstep
end
check(vtotal == 5 + 1 + 2 + 3, "in a loop")

# ---- maybes as Bools are: if x, not x, x and e, x or y
bmN := "42".toInt() or 0
bmBad := "4x".toInt() or -1
check(bmN == 42 and bmBad == -1, "x or y: x's value, else y")
bmM := "7".toInt()
bmSeen := 0
if bmM
  bmSeen = bmM + 1
end
check(bmSeen == 8, "if x: x its value inside")
check(not "z".toInt() and not not bmM, "not x")
check(bmM and bmM > 5, "x and a Bool: a Bool")
check(not (bmM and bmM > 50), "x and a Bool: false")
bmTwice := bmM and bmM * 2
check((bmTwice or 0) == 14, "x and a value: a maybe of it")
bmNone: ?Int
bmNil := bmNone and bmNone * 2
check(bmNil is nil and (bmNone or 9) == 9, "nil and e: nil")
bmF := true and 3
bmG := false and 3
check(bmF is Int and bmG is nil, "a Bool and a value: a maybe, false nil")
bmB: ?Bool = false
check(not (bmB or false) and bmB is Bool, "a ?Bool: x or false its truth, is whether it's there")
bmP: ?[2]Float
bmQ := bmP or {1, 2}
check(bmQ.y == 2, "or with a literal of the value's type")
bmFirst: ?Int
bmEither := bmFirst or "5".toInt()
check((bmEither or 0) == 5, "a maybe or a maybe: a maybe")
bmK := 0
for bmM and bmK < 3
  bmK += 1
end
check(bmK == 3, "a maybe in a loop's condition")
BmS :: struct
  size: Int
end
bmS: ?BmS = BmS{size = 4}
check(bmS and bmS.size > 3, "a struct's field, narrowed on the right of and")
check((bmS and bmS.size or 0) == 4, "and then or, on a struct's field")
bmCalls := 0
bmSide :: proc() -> Int
  bmCalls += 1
  return 1
end
bmZ := "1".toInt() or bmSide()
bmZ2 := bmNone or bmSide()
check(bmZ == 1 and bmZ2 == 1 and bmCalls == 1, "or runs y only when x is nil")
bmDouble :: proc(k: ?Int) -> Int
  return k and k * 2 or -1
end
check(bmDouble(bmM) == 14 and bmDouble(nil) == -1, "and then or, inside a proc")

# ---- narrowing when a test is false: else, the cases after, or's right side, after an if that leaves
nfF :: proc(m: ?Int) -> Int
  if m is nil do return 0
  return m + 1
end
check(nfF(4) == 5 and nfF(nil) == 0, "after an if that returns")
nfE :: proc(m: ?Int) -> Int
  if not m
    return 0
  else
    return m + 10
  end
end
check(nfE(1) == 11 and nfE(nil) == 0, "in the else of if not x")
nfOr :: proc(m: ?Int) -> Bool
  return not m or m > 5
end
check(nfOr(nil) and not nfOr(3) and nfOr(9), "the right side of or")
NfU :: union
  Int, String
end
nfS :: proc(x: NfU) -> Int
  if x is Int
    return x
  case x.len() > 3
    return 99
  end
  return x.len()
end
check(nfS(7) == 7 and nfS("hello") == 99 and nfS("ab") == 2, "a union of two: the other type, in the cases after and after")
nfWords := [3]String{"1", "x", "30"}
nfTotal := 0
for w in nfWords
  n := w.toInt()
  if not n do continue
  nfTotal += n
end
check(nfTotal == 31, "after an if that continues")
nfC :: proc(m: ?Int, a: Bool) -> Int
  if not m
    return 0
  case a
    nfTotal += 1
  end
  return m + 1
end
check(nfC(4, true) == 5 and nfC(5, false) == 6 and nfC(nil, true) == 0, "a later branch that gets to its end")
nfN :: proc(m: ?Int) -> Int
  if not (m and m > 3) do return 0
  return m
end
check(nfN(5) == 5 and nfN(2) == 0 and nfN(nil) == 0, "not (x and ...)")
nfTwo :: proc(m, n: ?Int) -> Int
  if not m or n is nil do return 0
  return m + n
end
check(nfTwo(1, 2) == 3 and nfTwo(nil, 2) == 0 and nfTwo(1, nil) == 0, "two, or-ed")

# ---- static procs: on a type, with no self
SpR :: struct
  pos, size: [2]Float
end
SpR.of :: static proc(x, y, w, h: Float) -> SpR
  return SpR{pos = {x, y}, size = {w, h}}
end
SpR.area :: proc() -> Float
  return self.size.x * self.size.y
end
spR := SpR.of(1, 2, 3, 4)
check(spR.area() == 12 and spR.pos.y == 2, "T.name(...) calls a static proc")
spMake := SpR.of
check(spMake(0, 0, 2, 2).area() == 4, "a static proc as a proc value")
SpDir :: enum
  north, east
end
SpDir.last :: static proc() -> SpDir
  return .east
end
Int.parsed :: static proc(s: String) -> Int
  return s.toInt() or 0
end
check(SpDir.last() == .east and SpDir.north == .north and Int.parsed("12") == 12, "on an enum, and on Int")
static := 3
check(static == 3, "static is a word only before proc, in a method's declaration")

# ---- returning values holding views: a struct with a String, a maybe, a loop's next
RvPair :: struct
  key: String
  n: Int
end
rvPairOf :: proc(k: String, n: Int) -> RvPair
  return RvPair{key = k, n = n}
end
rvFirstWord :: proc(s: String) -> ?String
  for c, i in s
    if c == ' ' do return s[0..<i] # (a parameter's view, from in a loop)
  end
  if s.len() == 0 do return nil
  return s
end
RvWords :: struct
  text: String
  at: Int
end
RvWords.next :: proc() -> ?String
  if self.at >= self.text.len() do return nil
  start := self.at
  for self.at < self.text.len() and self.text[self.at] != ' ' do self.at += 1
  self.at += 1
  return self.text[start..<self.at - 1]
end
rvLong :: proc(w: RvWords) -> ?String # (w has no memory of its own to view: its words are what it holds)
  for x in w
    if x.len() > 1 do return x
  end
  return nil
end
rvP := rvPairOf("ann", 3)
check(rvP.key == "ann" and rvP.n == 3 and rvPairOf("bo", 1).key.len() == 2, "a struct holding a String, returned")
check((rvFirstWord("hello there") or "-") == "hello" and (rvFirstWord("") or "-") == "-", "a ?String, returned")
rvSeen: Blob[..32]
for w in RvWords{text = "one two three"} do rvSeen.print(w, ";")
check(rvSeen[].asString() == "one;two;three;" and (rvLong(RvWords{text = "a bc d"}) or "") == "bc", "a loop's next returning a ?String")
rvMake := rvPairOf
check(rvMake("cy", 2).key == "cy", "through a proc value")

# ---- literals of constants: run while compiling, kept with the constants; a top-level variable from
# one starts as its words, and anything else copies them
LcDir :: enum
  north, east, south, west
end
LcP :: struct
  x, y: Int
  name: String
end
LcP.bump :: proc() -> Int
  self.x += 1
  return self.x
end
lcSquares := [8]Int{0, 1, 4, 9, 16, 25, 36, 49}
lcNames := [3]String{"red", "green", "blue"}
lcSteps := [LcDir][2]Int{{0, -1}, {1, 0}, {0, 1}, {-1, 0}}
lcHome := LcP{x = 3, y = 4, name = "home"}
lcBig := [20]Int{5, 6}
lcBytes: Blob[5] = {1, 2, 3, 250, 7}
lcI := 2
lcSquares[lcI] += 100
lcNames[0] = "crimson"
lcHome.x = 9
check(lcSquares[lcI] == 104 and lcSquares[7] == 49 and lcNames[0] == "crimson" and lcNames[lcI] == "blue", "top-level variables starting as literals, changed")
check(lcSteps[.east][0] == 1 and lcHome.x == 9 and lcHome.name == "home" and lcBig[1] == 6 and lcBig[19] == 0 and lcBytes[3] == 250, "nested, structs, big and bytes")
lcLookup :: proc(j: Int) -> Int
  local := [3]Int{10, 20, 30}
  local[0] += j
  return local[j] + local[0]
end
check(lcLookup(1) == 31 and lcLookup(2) == 42 and lcLookup(1) == 31, "in a proc: copied in at each call")
lcAgain := 0
for k in 0..<2
  again := [2]Int{7, 8}
  check(again[0] == 7 and again[1] == 8, "in a loop: copied in each time")
  again[k] = 0
  lcAgain += again[0] + again[1]
end
check(lcAgain == 15, "in a loop, changed")
check(LcP{x = 1}.bump() == 2 and [3]Int{4, 5, 6}[lcI] == 6, "a method on a literal changes a copy")
lcV := [2]Float{1, 2}
lcV = lcV + {0.5, 0.25}
check(lcV[0] == 1.5 and lcV[1] == 2.25, "arithmetic with a literal")

# ---- literals sized by their values, [_]T{...}, typed by the first too, [_]{...}; slice literals, []{...}
IlP :: struct
  x, y: Int
end
ilSum :: proc(xs: []Int) -> Int
  t := 0
  for x in xs do t += x
  return t
end
ilA := [_]Int{1, 2, 3}
ilB := [_]{1.5, 2, 3}
ilC := [_]{"red", "green"}
ilD := []{4, 5, 6, 7}
ilE := []String{"x", "y"}
ilF := [_]{IlP{x = 1}, {y = 2}}
ilG := [_]{[2]Int{1, 2}, {3, 4}}
check(ilA.len() == 3 and ilA[2] == 3 and ilB.len() == 3 and ilB[1] == 2.0 and ilC[1] == "green", "[_]T and [_], sized and typed")
check(ilD.len() == 4 and ilD[3] == 7 and ilE[0] == "x" and ilF[1].y == 2 and ilG[1][0] == 3, "slices, structs, nested")
ilD[0] = 40
check(ilSum(ilD) == 58 and ilSum({1, 2, 3}) == 6 and ilSum([]{10, 20}) == 30 and ilSum(ilA[]) == 6, "a slice literal, changed and passed")
ilEmpty := []Int{}
ilN := 7
ilH := [_]{ilN, ilN * 2, 3}
check(ilEmpty.len() == 0 and ilH[1] == 14 and ilH.len() == 3, "empty, and not constants")
ilFirst :: proc(k: Int) -> Int
  xs := []{k, k + 1, 9}
  ys := [_]{100, 200}
  ys[0] += k
  return xs[1] + ys[0] + ilSum(xs)
end
check(ilFirst(1) == 115 and ilFirst(2) == 119, "in a proc, built each call")

# ---- generic procs: proc[T], compiled once, each call passing T's size; a T only by &T or []T
GnP :: struct
  x, y: Int
  name: String
end
gnFind :: proc[T](xs: []T, x: &T, eq: proc(a, b: &T) -> Bool) -> Int
  for i in 0..<xs.len()
    if eq(&xs[i], &x) do return i
  end
  return -1
end
gnReverse :: proc[T](xs: []T)
  n := xs.len()
  for i in 0..<n / 2 do xs.swap(i, n - 1 - i)
end
GnLess :: (proc[T](a, b: &T) -> Bool)
gnSortBy :: proc[T](xs: []T, less: GnLess[T])
  for i in 1..<xs.len()
    j := i
    for j > 0 and less(&xs[j], &xs[j - 1])
      xs.swap(j, j - 1)
      j -= 1
    end
  end
end
gnFill :: proc[T](xs: []T, x: &T)
  for i in 0..<xs.len() do xs[i] = x
end
gnByY :: proc(a, b: &GnP) -> Bool do return a.y < b.y
gnLessP: GnLess[GnP] = gnByY
gnIntEq :: proc(a, b: &Int) -> Bool do return a == b
gnFloatEq :: proc(a, b: &Float) -> Bool do return a == b
gnStrLess :: proc(a, b: &String) -> Bool do return a[0] < b[0]
gnInts := [_]{5, 3, 9, 1}
gnReverse(gnInts[])
gn9 := 9
gn7 := 7
check(gnInts[0] == 1 and gnInts[3] == 5 and gnFind(gnInts[], &gn9, gnIntEq) == 1 and gnFind(gnInts[], &gn7, gnIntEq) == -1, "reverse and find, on Ints")
gnPs := [_]{GnP{x = 1, y = 30, name = "c"}, GnP{x = 2, y = 10, name = "a"}, GnP{x = 3, y = 20, name = "b"}}
gnSortBy(gnPs[], gnLessP)
check(gnPs[0].x == 2 and gnPs[1].x == 3 and gnPs[2].name == "c", "sort by a proc, on structs holding Strings")
gnFs := [4]Float{}
gnHalf := 2.5
gnFill(gnFs[], &gnHalf)
gnNames := [_]{"y", "z", "x"}
gnSortBy(gnNames[], gnStrLess)
gnNames.swap(0, 0)
check(gnFs[0] == 2.5 and gnFs[3] == 2.5 and gnFind(gnFs[], &gnHalf, gnFloatEq) == 0 and gnNames[0] == "x" and gnNames[2] == "z", "fill, and Strings sorted")
gnB: [..4]Int
ok := gnB.push(1) and gnB.push(2)
gnB.swap(0, 1)
check(gnB[0] == 2 and gnB[1] == 1, "swap on a builder")
GnList :: struct[T]
  items: []T
  less: GnLess[T]
end
gnSortList :: proc[T](l: &GnList[T]) do gnSortBy(l.items, l.less)
gnFirst :: proc[T](l: GnList[T]) -> Int do return l.items.len()
gnList := GnList[GnP]{items = gnPs[], less = gnByY}
gnPs[0].y = 99
gnSortList(&gnList)
gnOther: GnList[GnP] = gnList
check(gnPs[2].y == 99 and gnFirst(gnOther) == 3 and gnOther.items[0].y == 20, "a generic struct, filled in and passed to generic procs")
# ---- an if starting an else block is nested (found by tests/difftest.py)
nest := 0
if nest == 1
  nest = 10
else
  if nest == 0
    nest = 20
  end
  nest += 1
end
check(nest == 21, "if on the line after else")
check(1e99999999999 > 1e30 and 1e-99999999999 == 0.0, "huge exponents (found by fuzzing: overflowed and hung)")

# ---- proc values: proc(T, U) -> R; a proc used as a value can't call through proc values itself
PMob :: struct
  name, score: Int
end
pByScore :: proc(a: PMob, b: PMob) -> Bool
  return a.score < b.score
end
pByName :: proc(a: PMob, b: PMob) -> Bool
  return a.name < b.name
end
psort :: proc(xs: []PMob, less: proc(PMob, PMob) -> Bool) # stable insertion sort, any order
  for i in 1..<xs.len()
    x := xs[i]
    j := i
    for j > 0 and less(x, xs[j - 1])
      xs[j] = xs[j - 1]
      j -= 1
    end
    xs[j] = x
  end
end
pmobs: [5]PMob
for m, i in pmobs
  m = {name = 5 - i, score = (i * 7) % 3}
end
psort(pmobs[], pByScore)
check(pmobs[0].name == 5 and pmobs[1].name == 2 and pmobs[2].name == 4 and pmobs[4].score == 2, "sorted by a proc value, stably")
psort(pmobs[], pByName)
check(pmobs[0].name == 1 and pmobs[4].name == 5, "another order")
ptwice :: proc(n: Int) -> Int
  return n * 2
end
pinc :: proc(n: Int) -> Int
  return n + 1
end
papply :: proc(f: proc(Int) -> Int, n: Int) -> Int
  return f(f(n))
end
check(papply(ptwice, 3) == 12 and papply(pinc, 3) == 5, "a proc passed to a proc")
pg := ptwice
ph: proc(Int) -> Int
ph = pinc
POps :: struct
  op: proc(Int) -> Int
end
pops := POps{op = ptwice}
check(pg(21) == 42 and ph(1) == 2 and pops.op(5) == 10, "proc values in variables and fields")

# ---- assert: a runtime error at that line when the condition is false
assert(1 + 1 == 2)
assert(eds.len() == 4, "four directions")

# ---- ffi
t0 := clock()
check(t0 >= 0, "ffi clock")

# ---- labeled loops: break and continue the loop named
lab := 0
outer: for y in 0..<10
  for x in 0..<10
    if x == 3
      continue outer
    end
    if y == 5
      break outer
    end
    lab += 1
  end
end
check(lab == 15, "labeled continue and break")
labxs: [4]Int
labxs[2] = 7
labat := -1
search: for v, i in labxs
  for k in 0..<3
    if v == 7 and k == 1
      labat = i
      break search
    end
  end
end
check(labat == 2, "break out of a for-each by label")
labm := 0
rows: for
  labm += 1
  cols: for c in 0..<5
    if labm == 3
      break rows
    end
    continue cols
  end
end
check(labm == 3, "labels on plain loops")
inner: for i in 0..<2
end
inner: for i in 0..<2
  break inner
end
check(true, "a label can be reused after its loop ends")

# strings over more lines: an open line ends with a line break (its trailing spaces left out, but not
# escaped ones) and goes on at the next line's quote, after its indent; side by side, one string
ml :=
  "a   
  "  b
  "c"
check(ml == "a\n  b\nc", "a string over lines keeps what's after each quote")
mo := "x\t
     "
check(mo == "x\t\n\n", "an open last line keeps its line break, and an escaped tab stays")
check("p" "q" == "pq", "strings side by side on a line are one")
check(
  (
    "a" "b"
    "c"
  ) == "abc",
  "strings side by side over lines inside brackets are one",
)

# a trailing comma ends any list in brackets: arguments too
tcAdd :: proc(a: Int, b: Int,) -> Int
  return a + b
end
tcF: proc(Int, Int,) -> Int = tcAdd
tcXs := [3]Int{1, 2, 3,}
tcL: [..4]Int
tcL.push(5,)
check(tcAdd(1, 2,) == 3 and tcF(3, 4,) == 7 and tcXs[2] == 3 and tcL[0] == 5, "trailing commas")
check(
  "abc".len() == 3,
  "a trailing comma after the last argument, on its own line",
)
mw := "deep
                                                                                                    "er"
check(mw == "deep\ner", "a long indent before a string's next line (past the window, streamed)")
mn :=
  "ends
check(mn == "ends\n", "an open line with no quote on the next ends the string")

# hexBlob: bytes from hex digits, decoded while compiling; spaces and line breaks between them are fine
hb := hexBlob(
  "00 01 7f
  "80 ff 0A0b"
)
check(hb.len() == 7 and hb[0] == 0 and hb[2] == 127 and hb[3] == 128 and hb[4] == 255 and hb[5] == 10 and hb[6] == 11, "hexBlob decodes")
hb[0] = 42
check(hb[0] == 42, "hexBlob is writable")
hexAt :: proc() -> Blob
  return hexBlob("cafe")
end
hx := hexAt()
hx[0] = 1
check(hexAt()[0] == 1 and hexAt().len() == 2, "hexBlob: a call gives the same bytes each time, like a global")
check(hexBlob("").len() == 0, "hexBlob of nothing")

# ---- views passed in are borrowed: copied to be kept; a call's result may view what went in
keptName: Blob[..16]
rename :: proc(s: String)
  keptName.clear()
  ok := keptName.pushAll(s)
end
viewLen :: proc(s: String) -> Int
  return s.len()
end
viewRest :: proc(s: String) -> String
  return s[1..]
end
keptRest := ""
viewsPassed :: proc()
  b: Blob[8]
  b[0] = 'h'
  b[1] = 'i'
  rename(b[0..<2].asString())
  check(keptName[].asString() == "hi", "a view passed in, copied to be kept")
  check(viewLen(b[].asString()) == 8, "a view of a local, passed in")
  rest := viewRest(b[].asString())
  check(rest.len() == 7, "a view returned of a local's view, kept locally")
  keptRest = viewRest("literal")
  check(keptRest == "iteral", "a view returned of a constant, kept")
  lenOf := viewLen
  check(lenOf(b[].asString()) == 8, "through a proc value")
end
viewsPassed()

# ---- maybes: ?T, nil or a T
MaybePoint :: struct
  x, y: Int
end
Chaser :: struct
  hp: Int
  target: ?MaybePoint
  speed: ?Float
  after: Int        # (a field after maybes: the struct's fields stay together)
end
findAt :: proc(xs: []Int, want: Int) -> ?Int
  for x, i in xs
    if x == want
      return i
    end
  end
  return nil
end
doubled :: proc(n: ?Int) -> Int
  if n is Int
    return n * 2
  end
  return -1
end
maybeNums := [4]Int{5, 7, 9, 7}
foundAt := findAt(maybeNums[], 9)
check(foundAt is Int, "a maybe returned, holding a value")
if foundAt is Int
  check(foundAt == 2, "narrowed to its Int")
end
check(findAt(maybeNums[], 4) is nil, "a maybe returned, nil")
chaser: Chaser
check(chaser.target is nil and chaser.speed is nil and chaser.after == 0, "maybe fields start nil")
chaser.target = MaybePoint{x = 3, y = 4}
chaser.speed = 2
chaser.after = 9
chasing := chaser.target
if chasing is MaybePoint
  check(chasing.x + chasing.y == 7, "a maybe struct, narrowed")
end
check(chaser.after == 9, "the field after the maybes")
speedSaid := 0
switch chaser.speed
case nil
  speedSaid = 1
case Float
  speedSaid = 2
end
check(speedSaid == 2, "a switch on a maybe (an Int constant made a ?Float's Float)")
maybeGrid: [3]?Int
maybeGrid[1] = 5
check(maybeGrid[0] is nil and maybeGrid[1] is Int, "an array of maybes")
check(doubled(4) == 8 and doubled(nil) == -1, "maybe parameters: a value, nil")
nestedMaybe: ?[]?Int
check(nestedMaybe is nil, "?[]?Int: a maybe slice of maybes")
nestedMaybe = maybeGrid[]
if nestedMaybe is []?Int
  check(nestedMaybe.len() == 3 and nestedMaybe[1] is Int, "is with a written-out type, narrowed")
end
# a union stored into an array at an index only known running (its value and its tag both land)
storedAt: [4]?Int
for i in 0..<4
  storedAt[i] = i * 10
end
whereAt := 2
storedAt[whereAt] = 7
check(storedAt[0] is Int and storedAt[3] is Int, "unions stored at running indexes")
seen := 0
seenSum := 0
for m in storedAt # (a loop's element narrows, by if and by case)
  if m is Int
    seen += 1
    seenSum += m
  end
  switch m
  case nil
    seen -= 100
  case Int
    seenSum += m
  end
end
check(seen == 4 and seenSum == 2 * (0 + 10 + 7 + 30), "loop elements narrowed")
plusOne :: proc(n: &?Int) -> Int # (a & parameter narrows too)
  if n is Int
    return n + 1
  end
  return 0
end
check(plusOne(&storedAt[2]) == 8, "a & parameter narrowed")
# a struct with a proc type field not made before: its later fields stay its own
Handler :: struct
  id: Int
  run: proc(Int, Float, Bool) -> Int
  weight: Float
end
handler := Handler{id = 1, weight = 2.5}
check(handler.id == 1 and handler.weight == 2.5, "fields after a new proc type")

# ---- ranges: values, slices, loops and steps
rangeA := 2..<5
rangeB := 3..=3
rangeE := 7..<7
check(rangeA.first == 2 and rangeA.last == 4 and rangeA.len() == 3 and rangeB.len() == 1 and rangeE.len() == 0, "range values")
check(rangeA.has(2) and rangeA.has(4) and not rangeA.has(5) and not rangeE.has(7) and (5..=1).len() == 0, "has, and empty ranges")
rangeXs := [6]Int{10, 11, 12, 13, 14, 15}
rangeN := 2
check(rangeXs[1..<3].len() == 2 and rangeXs[1..=3].len() == 3 and rangeXs[4..][0] == 14 and rangeXs[..<2][1] == 11, "slice forms")
check(rangeXs[..=1].len() == 2 and rangeXs[].len() == 6 and rangeXs[rangeA][0] == 12 and rangeXs[rangeA].len() == 3, "more slice forms")
check(rangeXs[rangeN - 1..<rangeN + 1][1] == 12 and rangeXs[rangeN..=rangeN][0] == 12 and "hello"[1..=2].len() == 2, "computed bounds")
rangeOut := 0
for i in 0..<10 by 3
  rangeOut = rangeOut * 10 + i
end
check(rangeOut == 369, "stepping up")
rangeOut = 0
for i in 1..=4 by -1
  rangeOut = rangeOut * 10 + i
end
check(rangeOut == 4321, "stepping down from the last")
rangeOut = 0
rangeStep := -2
for i in rangeA by rangeStep
  rangeOut = rangeOut * 10 + i
end
check(rangeOut == 42, "a range value, by a step in a variable")
rangeOut = 0
for i in rangeA
  rangeOut += i
end
for i in rangeE by 2
  rangeOut += 100
end
check(rangeOut == 9, "a range value counts, an empty one doesn't")
rangeCount := 0
for i in 2147483640..=2147483647 by 4
  rangeCount += 1
end
for i in -2147483648..<-2147483640 by -5
  rangeCount += 10
end
check(rangeCount == 22, "steps stop at the ends of Int, never wrapping")
rangeOut = 0
for i in 0..<20 by 4
  if i == 8
    continue
  end
  if i == 16
    break
  end
  rangeOut += i
end
check(rangeOut == 16, "continue and break in a stepped loop")
rangeText: Blob[..20]
rangeText.print(rangeA, " ", rangeE)
check(rangeText[].asString() == "2..=4 7..=6", "ranges printed")

# ---- proc values as elements: arrays, slices, builders, [Enum]T, fields
procDouble :: proc(n: Int) -> Int
  return n * 2
end
procInc :: proc(n: Int) -> Int
  return n + 1
end
procSum :: proc(fs: []proc(Int) -> Int, n: Int) -> Int
  total := 0
  for f in fs
    total += f(n)
  end
  return total
end
procOps := [2]proc(Int) -> Int{procDouble, procInc}
check(procOps[1](2) == 3 and procSum(procOps[], 10) == 31, "an array of procs, called and passed as a slice")
procPick := 0
procOps[procPick] = procInc
procOne := procOps[procPick]
check(procOps[0](5) == 6 and procOne(1) == 2, "an element set at a running index, and taken out")
procByDir: [Dir]proc(Int) -> Int
procByDir[.east] = procDouble
procMore: [..4]proc(Int) -> Int
procMore.push(procDouble)
procMore.push(procInc)
check(procByDir[.east](4) == 8 and procMore.len() == 2 and procMore[1](7) == 8 and procSum(procMore[], 1) == 4, "by enum, and a builder")
ProcMachine :: struct
  steps: [2]proc(Int) -> Int
  n: Int
end
procMachine := ProcMachine{steps = procOps, n = 5}
procGrid: [2][2]proc(Int) -> Int
procGrid[1][0] = procDouble
check(procMachine.steps[1](procMachine.n) == 6 and procGrid[1][0](21) == 42, "in a struct, and nested arrays")

# ---- bitfields: Int(n) fields sharing words
BitHead :: struct
  kind: Int(4)
  level: Int(-4)
  flags: Int(8)
  size: Int(16)
  count: Int
  a, b: Int(3)
  wide: Int(31)
  low: Int(-31)
end
BitOuter :: struct
  tag: Int
  head: BitHead
end
bitHead: BitHead
bitHead.kind = 3
bitHead.level = -2
bitHead.flags = 255
bitHead.size = 70000
bitHead.count = 9
bitHead.a = 5
bitHead.b = 9
check(bitHead.kind == 3 and bitHead.level == -2 and bitHead.flags == 255 and bitHead.size == 4464, "bitfields keep their low bits")
check(bitHead.count == 9 and bitHead.a == 5 and bitHead.b == 1, "a field after bitfields, and two of a width")
bitHead.level -= 7
bitHead.kind += 1
check(bitHead.level == 7 and bitHead.kind == 4 and bitHead.flags == 255, "compound assignment to bitfields")
bitHead.wide = 0x7fffffff
bitHead.low = -0x40000000
check(bitHead.wide == 0x7fffffff and bitHead.low == -0x40000000 and bitHead.size + 1 == 4465, "31 bits")
bitBytes: Blob[24]
bitBytes.pack(0, bitHead)
check(bitBytes[0] == 0x74 and bitBytes[1] == 255 and bitBytes.getInt(2, 16) == 4464 and bitBytes.getInt(4, 32) == 9, "bitfields pack as laid out")
bitBytes.pack(20, bitHead.level)
check(bitBytes.getInt(20, 32) == 7, "a bitfield's value packs as an Int")
bitIn := hexBlob("f9 80 34 12 05 00 00 00 2e 00 00 00 ff ff ff 7f 00 00 00 40")
bitFrom: BitHead
bitIn.unpack(0, &bitFrom)
check(bitFrom.kind == 9 and bitFrom.level == -1 and bitFrom.flags == 0x80 and bitFrom.size == 0x1234 and bitFrom.count == 5, "bitfields unpacked from bytes")
check(bitFrom.a == 6 and bitFrom.b == 5 and bitFrom.wide == 0x7fffffff and bitFrom.low == -0x40000000, "the rest unpacked")
bitFrom.level = 3
bitIn.pack(0, bitFrom)
check(bitIn[0] == 0x39 and bitIn[1] == 0x80 and bitIn.getInt(2, 16) == 0x1234, "and packed back, the rest of the word kept")
bitLit := BitHead{kind = 15, size = 1, b = 2}
check(bitLit.kind == 15 and bitLit.level == 0 and bitLit.size == 1 and bitLit.a == 0 and bitLit.b == 2, "bitfields in a literal")
bitOuter: BitOuter
bitOuter.head.level = -8
bitOuters: [2]BitOuter
bitAt := 1
bitOuters[bitAt].head.flags = 7
bitOuters[bitAt].head.flags += 1
check(bitOuter.head.level == -8 and bitOuters[1].head.flags == 8 and bitOuters[0].head.flags == 0, "nested, and through an index")
bitsLocal :: proc(n: Int) -> Int
  h: BitHead
  h.level = n
  h.level -= 1
  h.kind = n * 2
  return h.level * 100 + h.kind
end
check(bitsLocal(3) == 206 and bitsLocal(-8) == 700 + 0, "bitfields of a local struct")
bitsOf :: proc(h: BitHead) -> Int
  return h.size
end
check(bitsOf(bitHead) == 4464, "a struct with bitfields passed")
bitText: Blob[..200]
bitText.print(bitLit)
check(bitText[].asString() == "BitHead{kind = 15, level = 0, flags = 0, size = 1, count = 0, a = 0, b = 2, wide = 0, low = 0}", "bitfields printed")
bitText.clear()
bitLit.level = -1
bitText.format({base = 16}, bitLit.level, " ", bitLit)
check(bitText.len() > 12 and bitText[0] == 'f', "bitfields formatted")

# ---- hex escapes
hexText := "A\x42\x7f\x00z"
check(hexText.len() == 5 and hexText[1] == 66 and hexText[2] == 127 and hexText[3] == 0 and hexText[4] == 122, "\\x in strings")
check('\xff' == 255 and '\x1B' == 27 and '\x0a' == '\n', "\\x in chars")

# ---- packing: values' bytes into and out of Blobs, and ints of a few bytes
PackHead :: struct
  tag: Blob[4]
  size: Int
  scale: Float
  ok: Bool
end
packHead: PackHead
packHead.tag[0] = 82
packHead.size = 1000
packHead.scale = 2.5
packHead.ok = true
packFile: Blob[40]
packFile.pack(2, packHead)
check(packFile[2] == 82 and packFile[6] == 232 and packFile[7] == 3, "pack a struct at an odd offset")
packBack: PackHead
packFile.unpack(2, &packBack)
check(packBack.tag[0] == 82 and packBack.size == 1000 and packBack.scale == 2.5 and packBack.ok, "unpack it")
packFile.pack(20, -3)
check(packFile.getInt(20, 16) == 65533 and packFile.getInt(20, -16) == -3 and packFile.getInt(20, 32) == -3, "getInt widths")
packFile.setInt(28, 24, 0x123456)
check(packFile[28] == 0x56 and packFile[30] == 0x12 and packFile[31] == 0 and packFile.getInt(28, 24) == 0x123456, "setInt")
packFile.setInt(28, 8, 200)
check(packFile.getInt(28, -8) == -56 and packFile.getInt(28, 8) == 200, "a signed byte")
packBits := 16
check(packFile.getInt(20, packBits) == 65533, "bits from a variable")
packInts: [3]Int
packInts[1] = 300
packFile.pack(8, packInts[1..<3])
packTwo: [2]Int
packFile.unpack(8, packTwo[])
check(packTwo[0] == 300 and packTwo[1] == 0, "a slice's elements, out and in")
packOut: Blob[..12]
check(packOut.pack(7) and packOut.pack(packHead.size) and packOut.len() == 8 and packOut.getInt(4, 16) == 1000, "appended")
check(not packOut.pack(packHead) and packOut.len() == 8, "appended all or nothing")
check("hi".getInt(0, 16) == 0x6968, "getInt from a String")
packF: Float
packFile.pack(36, 0.5)
packFile.unpack(36, &packF)
check(packF == 0.5, "a Float")

# >>>: an unsigned right shift (and >>>=), known now or not
ush := -8
ushn := 1
check(ush >>> ushn == 2147483644 and -8 >>> 1 == 2147483644 and ush >> ushn == -4 and 1 >>> 33 == 0, ">>>")
ush >>>= 28
check(ush == 15, ">>>=")

# a host proc as a proc value (through a proc of its own: the VM, an image and the C output alike)
clocks: [2]proc() -> Float
clocks[0] = clock
tick := clock
check(tick() >= 0.0 and clocks[0]() >= 0.0, "a host proc as a proc value")

log("bool", true, false, "int", 42, "float", 1.25, "neg", -0.5, "big", 123456789.0, "str", GREETING)
if fails == 0
  log("all tests passed")
end
