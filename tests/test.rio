// rio test suite: prints "FAIL" on any failed check (ctest watches for it)

fails := 0
check :: proc(ok: Bool, what: String)
  if !ok
    log("FAIL:", what)
    fails += 1
  end
end

// ---- arithmetic & inference
a := 7
b := 3
check(a + b == 10, "add")
check(a - b * 2 == 1, "precedence")
check(a / b == 2 && a % b == 1, "div mod")
check(-a == -7 && ~0 == -1 && !false, "unary")
check((a << 2) == 28 && (-16 >> 2) == -4, "shifts")
check((a & 3) == 3 && (a | 8) == 15 && (a ^ 1) == 6, "bitops")
check(0x7fffffff + 1 == -2147483647 - 1, "wraparound")
x := 1.5
y : Float = 2
check(x * y == 3.0, "float mul")
check(x + 1 == 2.5, "const coercion")
check(Float(a) / 2 == 3.5, "itof")
check(Int(3.9) == 3 && Int(-3.9) == -3, "ftoi")
c := 10
c += 5
c -= 1
c *= 2
c /= 4
check(c == 7, "compound assign")
check(1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 3 && 1 != 2, "compare")
check(false || true, "or")
check(!(true && false), "and")

// ---- Bool
done := false
check(!done && done == false && done != true, "bool basics")
done = 3 > 2
check(done, "bool from compare")
flags: [4]Bool
flags[2] = true
check(!flags[0] && flags[2], "bool array")
check(Int(true) + Int(false) == 1 && Bool(5) && !Bool(0), "bool casts")
nz := 7
check(Bool(nz) && Int(nz > 3) == 1, "bool casts runtime")
both :: proc(a: Bool, b: Bool) -> Bool
  return a && b
end
check(both(true, nz == 7) && !both(true, false), "bool params/return")
Flag :: struct
  on: Bool
  n: Int
end
fl := Flag{on = true, n = 2}
check(fl.on, "bool field")

// ---- constants
N :: 16
HALF :: N / 2
PI :: 3.14159
GREETING :: "hello"
check(HALF == 8, "const fold")
check(GREETING == "hello" && len(GREETING) == 5, "string const")

// ---- control flow
sum := 0
for i in 0..<10
  sum += i
end
check(sum == 45, "for range")
sum = 0
for i in 1..=10
  if i % 2 == 0
    continue
  end
  sum += i
end
check(sum == 25, "for continue")
n := 0
for n < 100
  n += 7
end
check(n == 105, "while")
n = 0
for
  n += 1
  if n == 5
    break
  end
end
check(n == 5, "loop break")
grade := 75
g := 0
if grade >= 90
  g = 1
else if grade >= 70
  g = 2
else
  g = 3
end
check(g == 2, "else if")

// ---- structs & contiguous arrays
Vec :: struct
  x, y: Float
end
Particle :: struct
  pos, vel: Vec
  life: Int
  tag: Blob[4]
end
parts: [100]Particle
for i in 0..<len(parts)
  parts[i].pos = Vec{x = Float(i), y = 0}
  parts[i].vel = Vec{x = 1, y = 2}
  parts[i].life = i
end
step :: proc(ps: []Particle, dt: Float)
  for i in 0..<len(ps)
    ps[i].pos.x += ps[i].vel.x * dt
    ps[i].pos.y += ps[i].vel.y * dt
    ps[i].life -= 1
  end
end
step(parts, 0.5)
check(parts[10].pos.x == 10.5 && parts[10].pos.y == 1 && parts[10].life == 9, "struct array update")
step(parts[50:], 1)
check(parts[49].life == 48 && parts[50].life == 48, "subslice")
parts[3].tag[0] = 'Z'
check(parts[3].tag[0] == 90 && len(parts[3].tag) == 4, "inline blob")
v := Vec{x = 3, y = 4}
w := v
w.x = 10
check(v.x == 3 && w.x == 10, "struct copy semantics")
partial := Particle{pos = Vec{x = 1, y = 1}}
check(partial.life == 0 && partial.vel.y == 0, "partial literal zeroes")
yx := Vec{y = 5, x = 6}
check(yx.x == 6 && yx.y == 5, "named fields in any order")
mid := Particle{life = 3, pos = Vec{x = 1, y = 2},}
check(mid.vel.x == 0 && mid.vel.y == 0 && mid.life == 3 && mid.pos.y == 2, "missing middle field zeroed, trailing comma")
check(Vec{}.x == 0 && Vec{}.y == 0, "empty literal")
for k in 0..<2
  q := Particle{life = k, pos = Vec{x = 1, y = 1}}
  if k == 0
    q.vel = Vec{x = 9, y = 9}
  else
    check(q.vel.x == 0 && q.vel.y == 0 && q.life == 1, "literal zeroes stale slots")
  end
end
// ordered init is just a helper proc
vec :: proc(x: Float, y: Float) -> Vec
  return Vec{x = x, y = y}
end
check(vec(7, 8).y == 8, "helper for ordered init")

dot :: proc(a: Vec, b: Vec) -> Float
  return a.x * b.x + a.y * b.y
end
add :: proc(a: Vec, b: Vec) -> Vec
  return Vec{x = a.x + b.x, y = a.y + b.y}
end
check(dot(v, Vec{x = 1, y = 1}) == 7, "struct params")
r := add(v, add(v, v))
check(r.x == 9 && r.y == 12, "struct return nested")
check(add(v, v).y == 8, "field of call")

// ---- slices, blobs, strings
data: [8]Int
for i in 0..<8
  data[i] = i * i
end
total :: proc(s: []Int) -> Int
  t := 0
  for i in 0..<len(s)
    t += s[i]
  end
  return t
end
check(total(data) == 140, "array to slice")
check(total(data[2:4]) == 13, "slice range")
check(total(data[:3]) == 5 && total(data[6:]) == 85, "open slices")
mid := data[1:7]
check(len(mid) == 6 && mid[0] == 1, "slice var")
buf: Blob[16]
for i in 0..<len(buf)
  buf[i] = 'a' + i
end
s := String(buf[0:5])
check(s == "abcde", "blob to string")
check(s[1] == 'b', "string index")
check(buf[255 & 3] == 'd', "blob index")
Named :: struct
  name: String
  id: Int
end
people: [3]Named
people[0] = Named{name = "ann", id = 1}
people[1].name = "bob"
check(people[1].name == "bob" && len(people[0].name) == 3, "strings in global structs")

// ---- math builtins
check(abs(-3) == 3 && abs(-2.5) == 2.5, "abs")
check(min(3, 4) == 3 && max(2.0, 5) == 5.0, "min max")
check(sqrt(16) == 4 && floor(2.7) == 2 && ceil(2.1) == 3 && round(2.5) == 3, "math")
check(abs(sin(0.0)) < 0.0001 && abs(cos(0.0) - 1) < 0.0001, "trig")
check(pow(2, 10) == 1024 && abs(atan2(1, 1) - PI / 4) < 0.001, "math2")

// ---- procs calling procs (no recursion)
sq :: proc(v: Int) -> Int
  return v * v
end
sumsq :: proc(a: Int, b: Int) -> Int
  return sq(a) + sq(b)
end
check(sumsq(3, 4) == 25 && sq(sq(2)) == 16 && sumsq(sq(1), sumsq(1, 1)) == 5, "nested calls")
counter := 0
bump :: proc()
  counter += 1
end
bump()
bump()
check(counter == 2, "globals from procs")

// ---- locals inside procs (static frames; AOT turns these into C locals)
scale2 :: proc(v: Vec, k: Float) -> Vec
  return Vec{x = v.x * k, y = v.y * k}
end
locals :: proc(n: Int) -> Int
  arr: [8]Int
  for i in 0..<len(arr)
    arr[i] = i + n
  end
  view := arr[2:6]
  t := total(view)
  v := Vec{x = 1, y = 2}
  w := scale2(v, 3)
  big: [32]Vec
  big[31] = w
  q := big[31]
  b: Blob[8]
  b[7] = 9
  j := 0
  for j < 3
    j += 1
  end
  part := Particle{pos = v, vel = w, life = 5}
  part.tag[1] = 4
  return t + Int(q.x + q.y) + b[7] + j + part.life + part.tag[1]
end
check(locals(10) == 54 + 9 + 9 + 3 + 5 + 4, "proc locals")
check(locals(0) == 14 + 30, "proc locals again")
nanv := sqrt(-1.0)
check(!(nanv < 1) && !(nanv >= 1) && nanv != nanv, "nan compares")
lt := 0
if nanv < 1
  lt = 1
end
check(lt == 0, "nan branch")

// ---- lists ([..N]T storage) and builders ([..]T views)
Enemy :: struct
  x, hp: Int
end
enemies: [..4]Enemy
check(len(enemies) == 0 && cap(enemies) == 4, "empty list")
spawnE :: proc(list: [..]Enemy, x: Int) -> Bool
  return push(list, Enemy{x = x, hp = 3})
end
for i in 0..<6
  spawnE(enemies, i * 10)
end
check(len(enemies) == 4 && enemies[3].x == 30, "push through a view; full list drops")
check(!push(enemies, Enemy{x = 99}), "push when full is false")
enemies[1].hp -= 1
swapRemove(enemies, 0)
check(len(enemies) == 3 && enemies[0].x == 30 && enemies[1].hp == 2, "swapRemove")
remove(enemies, 0)
check(len(enemies) == 2 && enemies[0].x == 10 && enemies[1].x == 20, "remove keeps order")
last := pop(enemies)
check(last.x == 20 && len(enemies) == 1, "pop")
live := enemies[:]
check(len(live) == 1 && live[0].x == 10, "list [:] is a slice of live elements")
clear(enemies)
check(len(enemies) == 0, "clear")
nums: [..8]Int
for i in 0..<5
  push(nums, i * i)
end
check(nums[4] == 16 && total(nums[:]) == 30 && total(nums[1:3]) == 5, "Int list and sub-slices")
title: Blob[..32]
label :: proc(b: Blob[..], score: Int) -> Bool
  clear(b)
  return format(b, "score: ", score, " ", 1.5, " ", true) && push(b, '!')
end
check(label(title, 42) && String(title[:]) == "score: 42 1.5 true!", "format appends text; push adds one byte")
tiny: Blob[..6]
check(pushAll(tiny, "abc") && !format(tiny, "de", 12345) && len(tiny) == 3, "format is all or nothing")
check(format(tiny, 12) && push(tiny, 65) && String(tiny[:]) == "abc12A" && !push(tiny, 66), "push on a Blob list is a byte")
check(format(tiny), "format with nothing to add")
more: [..8]Int
check(pushAll(more, nums) && !pushAll(more, nums) && len(more) == 5 && more[4] == 16, "pushAll is all or nothing")
check(pushAll(more, nums[3:]) && len(more) == 7 && more[6] == 16, "pushAll from a slice")
localList :: proc() -> Int
  xs: [..3]Int
  push(xs, 5)
  push(xs, 6)
  v := xs
  push(v, 7)
  return len(xs) * 100 + xs[2] + cap(v)
end
check(localList() == 310 && localList() == 310, "local list resets per call; := makes a view")
Inv :: struct
  items: [..3]Int
  gold: Int
end
bags: [2]Inv
push(bags[1].items, 9)
check(len(bags[1].items) == 1 && bags[1].items[0] == 9 && len(bags[0].items) == 0, "list inside a struct inside an array")

// ---- ffi
t0 := clock()
check(t0 >= 0, "ffi clock")

log("bool", true, false, "int", 42, "float", 1.25, "neg", -0.5, "big", 123456789.0, "str", GREETING)
if fails == 0
  log("all tests passed")
end
