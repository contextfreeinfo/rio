# module test: rio -L tests/modules/lib tests/modules/main.rio
import .geo
import .geo.{Vec, add as plus, UNIT}
import .shapes
import mathx
import mathx.{cube}
import mathx.extra                # a submodule mathx publishes
include "parts/util.rio"          # part of this file's module

fails := 0
check :: proc(ok: Bool, what: String)
  if not ok
    log("FAIL:", what)
    fails += 1
  end
end

v := geo.Vec{x = 3, y = 4}
check(v.len2() == 25, "an exported method travels with its type")
w: Vec = {x = 1, y = 1}
check(plus(v, w).x == 4, "selective import, renamed with as")
check(geo.Vec.zero().x == 0 and Vec.zero().y == 0, "an exported static proc travels with its type")
check(geo.add(v, w).y == 5, "qualified call")
check(UNIT == 1 and geo.UNIT == 1, "exported constant")
sized: [geo.UNIT * 4 + 1][UNIT + 1]Int
check(sized.len() == 5 and sized[0].len() == 2, "an array sized by arithmetic on another module's constants")
check(geo.ready, "the module's top-level code ran before ours")
geo.count += 2
check(geo.count == 3 and geo.bump() == 4, "module globals are shared")
c := shapes.circle.Circle{r = 2}
check(shapes.circle.area(c) > 12.56 and shapes.circle.area(c) < 12.57, "whole re-export of a local submodule")
check(shapes.unit().r == 1, "a directory module's own names")
check(mathx.sq(5) == 25 and cube(2) == 8 and mathx.cube(3) == 27, "package with an aliased export")
check(extra.answer == 42 and mathx.extra.answer == 42, "a published submodule, by path and through its package")
check(mathx.double(4) == 8, "a package's included part")
check(triple(3) == 9, "our own included part")
p: geo.Vec = {y = 2}
check(p.len2() == 4, "qualified type in a declaration")
if fails == 0
  log("all module tests passed")
end
