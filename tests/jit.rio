# loops the JIT compiles (only integer math, compares and branches inside): the same answers either way.
# ctest runs it in the VM; on ARM, rio -j runs it as native code.
fails := 0
check :: proc(ok: Bool, what: String)
  if not ok
    log("FAIL:", what)
    fails += 1
  end
end

# arithmetic, with wraparound
s := 0
p := 1
for i in 0..<1000
  s += i * 3 - 7
  p = p * 31 + i
end
check(s == 1491500 and p == 133786869, "add, sub, mul and wraparound")

# division and modulo: truncating, signs, and INT_MIN / -1 wraps
q := 0
r := 0
lo := -2147483648
m1 := -1
d := 0
for i in -20..<21
  if i != 0
    q += 1000 / i + (-1000) / i
    r += 1000 % i + (-7) % i
  end
end
w := 0
z := 1
for i in 0..<3
  w = lo / m1
  z = lo % m1
end
check(q == 0 and r == -2 and w == lo and z == 0, "div and mod")

# shifts mask their count to 0-31; >> keeps the sign
sh := 0
for i in 0..<70
  sh = sh ^ (1 << i) ^ (-256 >> i)
end
check(sh == 151, "shifts")

# bitwise, negation, not, abs, min, max
b := 0
mn := 1000
mx := -1000
ab := 0
for i in -50..<50
  b = b ^ (~i & 0x0F0F) | (-i & 0x30)
  mn = min(mn, i * 7 % 13)
  mx = max(mx, i * 5 % 17)
  ab += abs(i)
end
check(b == 48 and mn == -12 and mx == 16 and ab == 2500, "bit ops, min, max, abs")
ab2 := abs(lo)
check(ab2 == lo, "abs of INT_MIN wraps")

# comparisons as values, and conditions
lt := 0
eq := 0
for i in 0..<100
  a := i < 50
  e := i == 42
  if a and not e
    lt += 1
  end
  if e or i == 99
    eq += 1
  end
end
check(lt == 49 and eq == 2, "compares and conditions")

# while-style, nested, labeled break and continue
n := 0
cnt := 0
outer: for n < 100000
  n += 1
  for k in 0..<5
    if k == 3
      continue outer
    end
    if n == 5000
      break outer
    end
    cnt += 1
  end
end
check(n == 5000 and cnt == 4999 * 3, "nested loops with labels")

# big constants need two halves
big := 0
for i in 0..<10
  big += 123456789
end
check(big == 1234567890, "32-bit constants")

# many slots: the loop's variables sit past the first 1024 slots
pad0: [16]Int
pad1: [16]Int
pad2: [16]Int
pad3: [16]Int
pad4: [16]Int
pad5: [16]Int
pad6: [16]Int
pad7: [16]Int
