padk: [16]Int
padl: [16]Int
padm: [16]Int
padn: [16]Int
pado: [16]Int
padp: [16]Int
padq: [16]Int
padr: [16]Int
pads: [16]Int
padt: [16]Int
padu: [16]Int
padv: [16]Int
padw: [16]Int
padx: [16]Int
pady: [16]Int
padz: [16]Int
far := 0
for i in 0..<500
  far += i
end
check(far == 124750, "loop variables in far slots")

if fails == 0
  log("all jit tests passed")
end

# a runtime error inside a compiled loop reports its own line
zero := 0
acc := 0
for i in 0..<10
  acc += 100 / (zero + i - 5)
end
