# core.rio: the builtins, module core, declared (docs/spec/builtins.md says what they do). Programs
# don't import it: the builtins are always there, and as core.name too. It's what they are, written in Rio, and tests/host.c compiles
# it, so each declaration is checked against the builtin (its parameters and result), and every
# builtin is declared here or in the comments below.

# ---------------------------------------------------------------- types

Int* :: host struct      # 32 bits, signed; arithmetic wraps
Float* :: host struct    # 32 bits (IEEE single)
Bool* :: host struct     # true or false, stored as an Int (0 or 1)
String* :: host struct   # a read-only view of bytes: (address, length)
Blob* :: host struct     # a writable view of bytes: (address, length)

# how format writes values (b.format(settings, ...)); each field's 0 is as print writes it. Built in,
# as declared here (tests/host.c checks it's the same)
Format* :: struct
  width: Int              # numbers: at least this many bytes, padded with spaces (negative: on the right)
  digits: Int             # numbers: at least this many digits before the point, padded with zeros
  places: Int             # Floats: exactly this many digits after the point, rounded
  base: Int               # Ints: 2 to 16, of the bits (-1 is ffffffff in base 16)
  textWidth: Int          # text, Bools and enums' names: as width does for numbers
end

# a..<b and a..=b: the Ints from first to last (inclusive: empty when last < first). Printed first..=last.
# Built in, as declared here (tests/host.c checks it's the same), with these methods:
#   Range.len* :: host proc() -> Int            # how many values: last - first + 1, or 0
#   Range.has* :: host proc(i: Int) -> Bool     # first <= i <= last
Range* :: struct
  first: Int
  last: Int
end

# ---------------------------------------------------------------- math

abs* :: host proc(x: Int) -> Int
abs* :: host proc(x: Float) -> Float
min* :: host proc(a, b: Int) -> Int
min* :: host proc(a, b: Float) -> Float
max* :: host proc(a, b: Int) -> Int
max* :: host proc(a, b: Float) -> Float
clamp* :: host proc(x, lo, hi: Int) -> Int      # max(lo, min(x, hi))
clamp* :: host proc(x, lo, hi: Float) -> Float

sqrt* :: host proc(x: Float) -> Float
sin* :: host proc(x: Float) -> Float
cos* :: host proc(x: Float) -> Float
tan* :: host proc(x: Float) -> Float
asin* :: host proc(x: Float) -> Float
acos* :: host proc(x: Float) -> Float
atan* :: host proc(x: Float) -> Float
atan2* :: host proc(y, x: Float) -> Float
exp* :: host proc(x: Float) -> Float
ln* :: host proc(x: Float) -> Float      # the natural log
pow* :: host proc(x, y: Float) -> Float
fmod* :: host proc(x, y: Float) -> Float
floor* :: host proc(x: Float) -> Float
ceil* :: host proc(x: Float) -> Float
round* :: host proc(x: Float) -> Float   # halves away from zero

# ---------------------------------------------------------------- checks and data

assert* :: host proc(condition: Bool)                # a runtime error at this line when false
assert* :: host proc(condition: Bool, why: String)
hexBlob* :: host proc(digits: String) -> Blob        # a literal only: decoded while compiling

# ---------------------------------------------------------------- conversions

Int.toFloat* :: host proc() -> Float
Int.toBool* :: host proc() -> Bool       # n != 0
Float.toInt* :: host proc() -> Int       # toward zero; saturates; NaN is 0
Bool.toInt* :: host proc() -> Int        # 0 or 1
Blob.asString* :: host proc() -> String  # the same bytes, read-only

# text as a number: nil if it isn't one (docs/spec/expressions.md#text-as-numbers); base 2 to 36, left
# out or 0 for 10
String.toInt* :: host proc(base?: Int) -> ?Int
String.toFloat* :: host proc() -> ?Float
Blob.toInt* :: host proc(base?: Int) -> ?Int
Blob.toFloat* :: host proc() -> ?Float
(Blob[..]).toInt* :: host proc(base?: Int) -> ?Int
(Blob[..]).toFloat* :: host proc() -> ?Float

# ---------------------------------------------------------------- bytes

String.len* :: host proc() -> Int
String.cap* :: host proc() -> Int
Blob.len* :: host proc() -> Int
Blob.cap* :: host proc() -> Int

# Blob[..] is a byte builder view, for text
(Blob[..]).len* :: host proc() -> Int
(Blob[..]).cap* :: host proc() -> Int
(Blob[..]).push* :: host proc(byte: Int) -> Bool          # false when full
(Blob[..]).pushAll* :: host proc(text: String) -> Bool    # all or nothing
(Blob[..]).pop* :: host proc() -> Int                     # a runtime error when empty
(Blob[..]).clear* :: host proc()
(Blob[..]).remove* :: host proc(i: Int)                   # keeps the order
(Blob[..]).swapRemove* :: host proc(i: Int)               # the last element takes its place

# an int of bits (a constant: 8, 16, 24 or 32; negative: signed) at byte at, little-endian; a runtime
# error past the end (a byte builder's: its length)
String.getInt* :: host proc(at: Int, bits: Int) -> Int
Blob.getInt* :: host proc(at: Int, bits: Int) -> Int
Blob.setInt* :: host proc(at: Int, bits: Int, value: Int)   # its low bits
(Blob[..]).getInt* :: host proc(at: Int, bits: Int) -> Int
(Blob[..]).setInt* :: host proc(at: Int, bits: Int, value: Int)

# ---------------------------------------------------------------- sequences, for any element type T
#
# Each is checked as the others are, with T standing for a type of its own. A T by value is fine here:
# these are signatures only, and the builtins are compiled as they always were.

([]T).len* :: host proc[T]() -> Int                  # also on [N]T, [..N]T and [..]T
([..]T).cap* :: host proc[T]() -> Int                # also on [N]T and []T
([..]T).push* :: host proc[T](value: T) -> Bool       # false when full
([..]T).pushAll* :: host proc[T](values: []T) -> Bool # all or nothing
([..]T).pop* :: host proc[T]() -> T                  # a runtime error when empty
([..]T).clear* :: host proc[T]()
([..]T).remove* :: host proc[T](i: Int)              # keeps the order
([..]T).swapRemove* :: host proc[T](i: Int)          # the last element takes its place
([]T).swap* :: host proc[T](i, j: Int)               # also on [N]T, [..N]T and [..]T; not String

# ---------------------------------------------------------------- not declarable yet
#
# These take any printable or packable value, any enum E, a type, or any number of values: they'd need
# constraints, which generics don't have. Written in a pretend syntax: [T: C] after a name makes it
# generic over types meeting C, and ..T is any number of Ts.
#
#   log*[T: Printable] :: host proc(values: ..T)     # any values; one line, spaces
#                                                     # between
#   (Blob[..]).print*[T: Printable] :: host proc(values: ..T) -> Bool   # as text, all or nothing
#   (Blob[..]).format*[T: Printable] :: host proc(settings: Format, values: ..T) -> Bool
#                                                     # as print, as settings say, inside values too
#   Blob.pack*[T: Packable] :: host proc(at: Int, value: T)   # its bytes at byte at, as in memory
#   (Blob[..]).pack*[T: Packable] :: host proc(value: T) -> Bool   # appended, all or nothing
#   String.unpack*[T: Packable] :: host proc(at: Int, into: &T)    # also Blob's, (Blob[..])'s;
#                                                     # into a []T or [..]T too (its elements), no &
#                                                     # Packable: no views or proc values inside;
#                                                     # a []T or [..]T packs its elements
#   sizeOf*[T] :: host proc(t: T) -> Int          # T's bytes, a constant: sizeOf(T) or sizeOf(x)
#                                                     # (not a view's; a struct's is what pack writes)
#   offsetOf*[S: struct] :: host proc(s: S, path) -> Int   # offsetOf(S, .a.b): the byte where the
#                                                     # field starts (a bitfield's: its lowest bit's)
#   bitOffsetOf*[S: struct] :: host proc(s: S, path) -> Int   # the same, in bits
#   E.fromInt*[E: enum] :: host proc(n: Int) -> E    # a runtime error if n isn't one of E's values
#   E.has*[E: enum] :: host proc(n: Int) -> Bool
#   (E).toInt*[E: enum] :: host proc() -> Int
