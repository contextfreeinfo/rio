# abstract := for void be magic

# Array := for Item:Type size:Int be magic

Claim := Maybe[Void, Void]

# Class := struct with
#     face:Interface
#     fields:(List Field)
# end

# describe := for Value:Type be for value:Value :String be magic

Either[YesValue, NoValue] := union of
    Yes[YesValue]
    No[NoValue]
end

Error := struct of
    message Text
end

error := for(message Text) be Error { message }

false := null[Void]

# Field := struct with
#     # TODO This needs dynamic typing and sizing for `type` and `default`.
#     name:Text
#     type:Type
#     default:(Maybe type)
#     offset:Int
# end

Float := magic as Type

Int := magic as Type
# Int := class with
#     add := for other:Int :Int be magic
#     eq := for other:Int :Claim be magic
#     ge := for other:Int :Claim be magic
#     gt := for other:Int :Claim be magic
#     le := for other:Int :Claim be magic
#     lt := for other:Int :Claim be magic
#     ne := for other:Int :Claim be magic
#     sub := for other:Int :Int be magic
# end

# Interface := struct with
#     name:Text
#     # TODO constructor separate?
#     # methods:(List Function)
# end

List[Item] := magic as Type

log[Value] := for (value Value) Void be magic
# # TODO Also think and cry for log levels?

magic = magic

Maybe[Value] := Either[Value, Void]

# Keeping YesValue purposely makes this hard to use in isolation.
No[YesValue, NoValue] := struct of
    value NoValue
end

no[YesValue, NoValue] := for(value NoValue) No[YesValue, _] be No { value }

null[Value] := no[Value, _](void)

# Pair := for Key:Type Value:Type be struct with
#     key:Key
#     value:Value
# end

# pair := for Key:Type Value:Type be for key:Key value:Value be Pair {key, value}

# Predicate := for Subject:Type be
#     interface for subject:Subject :Claim be abstract
# end

Ref[Value] := class(val Value) of
    value := val
end

# Struct := struct with
#     name:Text
#     fields:(List Field)
# end

true := yes(void)

Text := magic as Type

Try[Value] := Either[Value, Error]

Type := magic as Type
# Type := union ... ???

Void := magic as Type

void := magic as Void

# Yes can be used in isolation as a box.
Yes[Value] := struct of
    value Value
end

yes[Value] := for(value Value) be Yes { value }
