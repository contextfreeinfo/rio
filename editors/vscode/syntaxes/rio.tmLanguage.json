{
  "$comment": "Rio's colors, by the kinds rio_highlight has (src/fmt.c): words, types, calls, numbers, strings, comments",
  "name": "Rio",
  "scopeName": "source.rio",
  "patterns": [
    { "name": "comment.line.number-sign.rio", "match": "#.*$" },
    {
      "name": "string.quoted.double.rio",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [{ "name": "constant.character.escape.rio", "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|.)" }]
    },
    { "name": "string.quoted.single.rio", "match": "'(\\\\.|[^'\\\\])'" },
    { "name": "constant.language.rio", "match": "\\b(true|false|nil)\\b" },
    { "name": "keyword.control.rio", "match": "\\b(if|else|for|in|end|return|break|continue|switch|case|do|by|import|include)\\b" },
    { "name": "keyword.other.rio", "match": "\\b(proc|struct|enum|union|static|callback|host)\\b" },
    { "name": "keyword.operator.word.rio", "match": "\\b(and|or|not|is)\\b" },
    { "name": "constant.numeric.rio", "match": "\\b(0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][-+]?[0-9]+)?)\\b" },
    { "name": "entity.name.type.rio", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    { "name": "entity.name.function.rio", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()" },
    { "name": "keyword.operator.rio", "match": "::|:=|->|\\.\\.[<=]|[-+*/%=<>!&|^~]" }
  ]
}
