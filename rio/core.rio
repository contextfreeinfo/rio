pub

Any :: extern struct

Bool :: Maybe[Void]

Either :: union[YesValue, NoValue]
    Yes[YesValue]
    No[NoValue]
end

Error :: struct
    message: String
end

error :: proc(message: String) -> Error
    return { message }
end

false :: no[Void](void)

Float32 :: extern struct

Int :: extern struct

len :: proc
    list_len
    ref_len
    weak_len
end

List :: extern struct[Item]

log :: extern proc(message: String)

Maybe :: union[Value]
    Either[Value, Void]
end

nil :: false

No :: struct[Value]
    value: Value
end

no :: proc[Value](value: Value) -> No[Value]
    return { value }
end

Ref :: extern struct[Value]

Span :: struct[Item]
    list: List[Item]
    range: Range
end

String :: struct
    slice: Span[UInt8]
end

true :: yes(void)

Try :: union[Value]
    Either[Value, Error]
end

Type :: extern struct

UInt8 :: extern struct

Void :: struct
end

void :: Void {}

Weak :: extern struct[Value]

Yes :: struct[Value]
    value: Value
end

yes :: proc[Value](value: Value) -> Yes[Value]
    return { value }
end
