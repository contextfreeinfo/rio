Any :: handle

Bool :: Maybe[Void]

Either :: union($YesValue: Type, $NoValue: Type)
    Yes(YesValue)
    No(NoValue)
end

Error :: struct
    message: String
end

error :: proc(message: String): Error
    err = { message }
end

Float32 :: opaque

Int :: opaque

List :: struct($Item: Type)
end

log :: proc(message: String)
end

Try :: union($Value: Type)
    Either(Value, Error)
end

Type :: opaque
