pub

access :: extern proc[Value](box: Weak[Value]) -> Maybe[Box[Value]]

Any :: extern union

Array :: extern struct[Item: Type, len: int]

Bool :: Maybe[Void]

Box :: extern struct[Value]

box :: extern proc[Value](value: Value) -> Box[Value]

Either :: union[YesValue, NoValue]
    Yes[YesValue]
    No[NoValue]
end

Error :: struct
    message: String
end

error :: proc(message: String) -> Error
    return { message }
end

false :: no[Void](void)

Float32 :: extern struct

Int :: extern struct

List :: extern struct[Item]

log :: extern proc(message: String)

Maybe :: union[Value]
    Either[Value, Void]
end

nil :: false

No :: struct[Value]
    value: Value
end

no :: proc[Value](value: Value) -> No[Value]
    return { value }
end

slice :: proc
    arraySlice
    listSlice
end

Span :: extern struct[Item]

String :: struct
    span: Span[UInt8]
end

true :: yes(void)

Try :: union[Value]
    Either[Value, Error]
end

Type :: extern struct

UInt8 :: extern struct

unbox :: extern proc[Value](box: Box[Value]) -> Value

Void :: struct
end

void :: Void {}

Weak :: extern struct[Value]

weak :: extern proc[Value](value: Box[Value]) -> Weak[Value]

Yes :: struct[Value]
    value: Value
end

yes :: proc[Value](value: Value) -> Yes[Value]
    return { value }
end
