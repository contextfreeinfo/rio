pub

Any :: opaque

Bool :: Maybe[Void]

Either :: union[YesValue, NoValue]
    Yes[YesValue]
    No[NoValue]
end

Error :: struct
    message: String
end

error :: proc(message: String) -> Error
    return { message }
end

false :: nil[Void]

Float32 :: opaque

Int :: opaque

len :: proc
    list_len
    ref_len
    weak_len
end

List :: opaque[Item]

log :: proc(message: String)
end

Maybe :: union[Value]
    Either[Value, Void]
end

nil :: proc[Value] -> No[Value, Void]
    return no[Value, _](void)
end

No :: struct[YesValue, NoValue]
    value: NoValue
end

no :: proc[YesValue, NoValue](value: NoValue) -> No[NoValue]
    return { value }
end

Ref :: opaque[Value]

String :: opaque

true :: yes(void)

Try :: union[Value]
    Either[Value, Error]
end

Type :: opaque

Void :: struct
end

void :: Void {}

Weak :: opaque[Value]

Yes :: struct[Value]
    value: Value
end

yes :: proc[Value](value: Value) -> No[Value]
    return { value }
end
